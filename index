async function callCohere(payload) {
  /*
    IMPORTANTE:
    No coloques una API key de Cohere directamente aquí en producción.

    Este frontend espera un endpoint propio:

      POST /api/moderate-banner

    El backend debe recibir el JSON anterior, llamar a Cohere
    y devolver exclusivamente el objeto estructurado de resultado.

    Ejemplo esperado del backend:

      {
        "decision": "REVIEW",
        "risk_level": "MEDIUM",
        "compliant": false,
        "violations": [],
        "warnings": [],
        "explanation": "..."
      }
  */

  const response = await fetch("/api/moderate-banner", {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify(payload)
  });

  if (!response.ok) {
