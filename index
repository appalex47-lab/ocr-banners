<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Banner AI — Validador Regulatorio Fase 10.5 OCR</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
<style id="ocr-ui-normalization">
/* OCR UI normalization: one visual hierarchy, fixed technical detail rhythm. */
.ocr-enhanced-panel{font-size:13px;line-height:1.45}
.ocr-enhanced-panel .ocr-section-title{font-size:13px;font-weight:700;line-height:1.25}
.ocr-enhanced-panel .ocr-section-label{font-size:11px;font-weight:700;line-height:1.25;letter-spacing:.01em}
.ocr-enhanced-panel table{font-size:11px;line-height:1.35}
.ocr-enhanced-panel table th,.ocr-enhanced-panel table td{padding:.5rem .65rem!important;vertical-align:middle}
.ocr-enhanced-panel .ocr-meta-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem}
.ocr-enhanced-panel .ocr-meta-item{min-width:0;border:1px solid #e2e8f0;border-radius:.65rem;background:#f8fafc;padding:.55rem .65rem}
.ocr-enhanced-panel .ocr-meta-label{font-size:10px;color:#64748b;font-weight:600;line-height:1.2}
.ocr-enhanced-panel .ocr-meta-value{font-size:12px;color:#1e293b;font-weight:700;line-height:1.3;margin-top:.2rem;overflow-wrap:anywhere}
.ocr-enhanced-panel .ocr-review-list{max-height:180px;overflow:auto}
.ocr-enhanced-panel .ocr-review-item{font-size:11px;line-height:1.4;padding:.35rem 0;border-bottom:1px solid #f1f5f9}
.ocr-enhanced-panel .ocr-review-item:last-child{border-bottom:0}
.ocr-enhanced-panel .ocr-pass-list{display:flex;flex-direction:column;gap:.3rem}
.ocr-enhanced-panel .ocr-pass{display:block;font-size:10px;line-height:1.3;padding:.3rem .45rem;border-radius:.45rem;background:#f8fafc;color:#475569}
.ocr-enhanced-panel .ocr-corrections{display:flex;flex-direction:column;gap:.3rem}
.ocr-enhanced-panel .ocr-correction{font-size:11px;line-height:1.35;padding:.35rem .45rem;background:#f8fafc;border-radius:.45rem}
.ocr-text-output{font-size:13px!important;line-height:1.6!important;min-height:190px;resize:vertical;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono","Courier New",monospace}
.ocr-progress-step{font-size:11px;line-height:1.3}
.ocr-zone-output{font-size:13px!important;line-height:1.65!important;white-space:pre-wrap;word-break:normal;overflow-wrap:anywhere;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono","Courier New",monospace}
.ocr-zone-card{border:1px solid #e2e8f0;border-radius:.65rem;background:#fff;padding:.65rem}
.ocr-zone-title{font-size:11px;font-weight:700;color:#334155;line-height:1.25}
.ocr-critical-item{font-size:11px;line-height:1.4;padding:.45rem .55rem;border-radius:.5rem;background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
.ocr-tech-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem}
@media (max-width:640px){.ocr-tech-grid{grid-template-columns:1fr}}
@media (max-width:640px){.ocr-enhanced-panel .ocr-meta-grid{grid-template-columns:1fr}.ocr-text-output{font-size:12px!important}}

<style id="fase10-4-audit-ui">
.ocr-image-stage{position:relative;display:block;width:100%;line-height:0;overflow:hidden}
.ocr-image-stage img{display:block;width:100%;height:auto;max-width:100%;object-fit:initial}
.ocr-overlay-canvas{position:relative;display:block;width:100%;height:auto;max-width:100%;pointer-events:none}
.ocr-box{position:absolute;border:2px solid rgba(99,102,241,.72);background:rgba(99,102,241,.06);box-sizing:border-box}
.ocr-box.critical{border-color:rgba(220,38,38,.9);background:rgba(220,38,38,.10)}
.ocr-box.region{border-color:rgba(14,165,233,.75);background:rgba(14,165,233,.05)}
.ocr-box.line{border-color:rgba(16,185,129,.75);background:rgba(16,185,129,.05)}
.ocr-overlay-legend{font-size:10px;line-height:1.25}
.ocr-overlay-label{position:absolute;left:0;top:0;transform:translateY(-100%);font-size:9px;line-height:1;padding:2px 4px;border-radius:3px;background:rgba(15,23,42,.82);color:#fff;white-space:nowrap}
.ocr-final-summary{border:1px solid #fecaca;background:#fff7f7;border-radius:.85rem;padding:.7rem .8rem}
.ocr-final-summary.approved{border-color:#bbf7d0;background:#f0fdf4}
.ocr-final-summary.review{border-color:#fde68a;background:#fffbeb}
</style>
</head>

<body data-build="fase-10-5-1-reconstruccion-espacial-determinista" class="bg-slate-100 text-slate-800 min-h-screen">
<div class="max-w-6xl mx-auto p-4 sm:p-6 pb-20">

<header class="mb-6">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Validador de Banners con IA</h1>
      <p class="text-sm text-slate-500 mt-1">
        Fase 10.5 — Reconstrucción OCR por palabra + geometría + evidencia crítica.
      </p>
    </div>
    <span id="engineStatus" class="text-xs px-3 py-1.5 rounded-full bg-blue-100 text-blue-700 font-medium">
      Motor listo
    </span>
  </div>
</header>

<section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 mb-5">
  <div class="grid md:grid-cols-2 gap-5">
    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-2">
        Categoría regulatoria
      </label>
      <select id="productCategory"
        class="w-full px-4 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="otc">Medicamento OTC</option>
        <option value="glp1">Tratamiento GLP-1 / Control de Peso</option>
        <option value="general">Suplemento / General</option>
      </select>
      <p id="categoryDescription" class="text-xs text-slate-500 mt-2"></p>
    </div>

    <div>
      <label class="block text-sm font-semibold text-slate-700 mb-2">
        Modo de análisis
      </label>
      <select id="aiMode"
        class="w-full px-4 py-2.5 border border-slate-300 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="simulation">Simulación semántica (sin API)</option>
      </select>
      <p class="text-xs text-slate-500 mt-2">
        Fase OCR 5: esta versión se mantiene sin llamada de red a Cohere para aislar y validar el consenso entre lecturas OCR.
      </p>
    </div>
  </div>

  <div class="mt-5">
    <h2 class="text-sm font-semibold text-slate-700 mb-2">Reglas activas</h2>
    <div id="rulesList" class="flex flex-wrap gap-2"></div>
  </div>
</section>

<section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 mb-6">
  <div id="dropZone"
    class="border-2 border-dashed border-slate-300 rounded-2xl p-8 text-center cursor-pointer hover:border-indigo-500 hover:bg-indigo-50/30 transition">
    <input type="file" id="fileInput" multiple accept="image/*" class="hidden">
    <div class="text-3xl mb-2">🖼️</div>
    <p class="font-semibold text-slate-700">Selecciona o arrastra tus banners</p>
    <p class="text-xs text-slate-500 mt-1">Puedes procesar múltiples imágenes en un solo lote.</p>
  </div>

  <div class="mt-4 flex flex-wrap gap-2">
    <button id="analyzeBatchBtn" disabled
      class="px-4 py-2 rounded-xl bg-indigo-600 text-white text-sm font-semibold disabled:opacity-40 disabled:cursor-not-allowed hover:bg-indigo-700">
      Analizar lote
    </button>
    <button id="clearBtn"
      class="px-4 py-2 rounded-xl bg-slate-100 text-slate-700 text-sm font-semibold hover:bg-slate-200">
      Limpiar
    </button>
  </div>

  <div id="batchProgress" class="hidden mt-4">
    <div class="flex justify-between text-xs mb-1">
      <span id="progressText">Analizando imagen…</span>
      <span id="progressPercent">0%</span>
    </div>
    <div class="h-2 bg-slate-200 rounded-full overflow-hidden">
      <div id="progressBar" class="h-full bg-indigo-600 transition-all" style="width:0%"></div>
    </div>
    <div id="analysisStages" class="mt-3 grid sm:grid-cols-2 gap-1.5 text-[11px] text-slate-500">
      <div data-stage="prepare">○ Preparando imagen <span data-stage-time="prepare" class="ml-1 text-slate-400">—</span></div>
      <div data-stage="main">○ OCR principal <span data-stage-time="main" class="ml-1 text-slate-400">—</span></div>
      <div data-stage="regions">○ Analizando regiones <span data-stage-time="regions" class="ml-1 text-slate-400">—</span></div>
      <div data-stage="consolidate">○ Consolidando resultados <span data-stage-time="consolidate" class="ml-1 text-slate-400">—</span></div>
      <div data-stage="reconstruct">○ Reconstruyendo texto <span data-stage-time="reconstruct" class="ml-1 text-slate-400">—</span></div>
      <div data-stage="validate">○ Validando contenido <span data-stage-time="validate" class="ml-1 text-slate-400">—</span></div>
    </div>
    <div class="mt-2 text-xs text-slate-600">
      Tiempo transcurrido: <span id="analysisElapsed" class="font-semibold">0.0 s</span>
    </div>
  </div>
</section>

<section>
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-lg font-bold text-slate-900">Resultados</h2>
    <span id="summary" class="text-xs text-slate-500"></span>
  </div>
  <div id="resultsContainer" class="space-y-5"></div>
</section>

</div>

<script>
/* ============================================================
   1. CONFIGURACIÓN REGULATORIA
   ============================================================ */

const categoryRules = {
  otc: {
    label: "OTC",
    description: "Permite ciertos contextos preventivos o de alivio, pero prohíbe promesas absolutas o engañosas.",
    forbidden: [
      "cura definitiva",
      "100% garantizado",
      "elimina la enfermedad para siempre"
    ],
    semanticRisks: [
      "promesa de curación absoluta",
      "garantía de resultado",
      "eliminación permanente de una enfermedad"
    ],
    allowedContext:
      "Puede permitirse lenguaje preventivo o de alivio cuando sea compatible con el contexto regulatorio y las advertencias aplicables."
  },

  glp1: {
    label: "GLP-1",
    description: "Categoría de alta restricción. Las promesas directas, milagrosas o no sustentadas de pérdida de peso generan alto riesgo.",
    forbidden: [
      "bajar de peso",
      "baja de peso sin esfuerzo",
      "adelgaza rápido",
      "quema grasa milagrosa",
      "garantizado"
    ],
    semanticRisks: [
      "promesa directa de pérdida de peso",
      "pérdida de peso rápida",
      "resultado garantizado",
      "resultado sin esfuerzo",
      "lenguaje milagroso",
      "reducción de peso sin contexto"
    ],
    allowedContext:
      "No se debe asumir que una frase es aceptable solo porque no coincide literalmente con una palabra prohibida."
  },

  general: {
    label: "GENERAL",
    description: "Reglas generales contra afirmaciones engañosas, absolutas o milagrosas.",
    forbidden: [
      "milagro",
      "cura todo",
      "sin efectos secundarios"
    ],
    semanticRisks: [
      "afirmación milagrosa",
      "curación universal",
      "ausencia absoluta de efectos secundarios"
    ],
    allowedContext:
      "Debe evitarse lenguaje absoluto o que pueda inducir a una expectativa irreal."
  }
};

/* ============================================================
   2. ESTADO DE LA APLICACIÓN
   ============================================================ */

const state = {
  files: [],
  results: [],
  worker: null,
  currentCategory: "otc"
};

/* ============================================================
   3. ELEMENTOS UI
   ============================================================ */

const categorySelect = document.getElementById("productCategory");
const aiMode = document.getElementById("aiMode");
const categoryDescription = document.getElementById("categoryDescription");
const rulesList = document.getElementById("rulesList");
const dropZone = document.getElementById("dropZone");
const fileInput = document.getElementById("fileInput");
const analyzeBatchBtn = document.getElementById("analyzeBatchBtn");
const clearBtn = document.getElementById("clearBtn");
const resultsContainer = document.getElementById("resultsContainer");
const batchProgress = document.getElementById("batchProgress");
const progressText = document.getElementById("progressText");
const progressPercent = document.getElementById("progressPercent");
const progressBar = document.getElementById("progressBar");
const analysisStages = document.getElementById("analysisStages");
const analysisElapsed = document.getElementById("analysisElapsed");
const summary = document.getElementById("summary");
const engineStatus = document.getElementById("engineStatus");

/* ============================================================
   4. UTILIDADES
   ============================================================ */

function normalizeText(text = "") {
  return String(text || "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[\r\n]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function escapeHtml(value = "") {
  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

function uid() {
  return "banner-" + crypto.randomUUID();
}

function setProgress(current, total, message) {
  const percent = total ? Math.round((current / total) * 100) : 0;
  progressText.textContent = message;
  progressPercent.textContent = `${percent}%`;
  progressBar.style.width = `${percent}%`;
}

function setAnalysisStage(stage, state = "active") {
  if (!analysisStages) return;
  const states = {
    done: "✓",
    active: "⟳",
    pending: "○"
  };
  analysisStages.querySelectorAll("[data-stage]").forEach(el => {
    const key = el.dataset.stage;
    const label = el.textContent.replace(/^[✓⟳○]\s*/, "");
    if (key === stage) {
      el.textContent = `${states[state] || states.active} ${label}`;
      el.className = "font-semibold text-indigo-700";
    } else if (state === "done" && ["prepare","main","regions","consolidate","reconstruct","validate"].indexOf(key) < ["prepare","main","regions","consolidate","reconstruct","validate"].indexOf(stage)) {
      el.textContent = `✓ ${label}`;
      el.className = "text-emerald-700";
    }
  });
}

function resetAnalysisStages() {
  if (!analysisStages) return;
  analysisStages.querySelectorAll("[data-stage]").forEach(el => {
    const label = el.textContent.replace(/^[✓⟳○]\s*/, "");
    el.textContent = `○ ${label}`;
    el.className = "text-slate-500";
  });
}

function formatElapsed(ms) {
  return ms < 10000 ? `${(ms / 1000).toFixed(1)} s` : `${(ms / 1000).toFixed(1)} s`;
}

/* ============================================================
   5. CATEGORÍA
   ============================================================ */

function updateCategoryRules() {
  const category = categoryRules[categorySelect.value];
  state.currentCategory = categorySelect.value;

  categoryDescription.textContent = category.description;
  rulesList.innerHTML = "";

  category.forbidden.forEach(rule => {
    const tag = document.createElement("span");
    tag.className =
      "inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800";
    tag.textContent = `Prohibido: ${rule}`;
    rulesList.appendChild(tag);
  });
}

categorySelect.addEventListener("change", updateCategoryRules);
updateCategoryRules();

/* ============================================================
   6. CARGA DE ARCHIVOS
   ============================================================ */

dropZone.addEventListener("click", () => fileInput.click());

dropZone.addEventListener("dragover", event => {
  event.preventDefault();
  dropZone.classList.add("border-indigo-500", "bg-indigo-50");
});

dropZone.addEventListener("dragleave", () => {
  dropZone.classList.remove("border-indigo-500", "bg-indigo-50");
});

dropZone.addEventListener("drop", event => {
  event.preventDefault();
  dropZone.classList.remove("border-indigo-500", "bg-indigo-50");
  addFiles(event.dataTransfer.files);
});

fileInput.addEventListener("change", event => {
  addFiles(event.target.files);
  fileInput.value = "";
});

function addFiles(fileList) {
  const images = Array.from(fileList).filter(file =>
    file.type.startsWith("image/")
  );

  images.forEach(file => {
    state.files.push({
      id: uid(),
      file,
      category: state.currentCategory,
      imageUrl: URL.createObjectURL(file)
    });
  });

  renderCards();
  analyzeBatchBtn.disabled = state.files.length === 0;
}

/* ============================================================
   7. RENDER DE TARJETAS
   ============================================================ */

function renderCards() {
  resultsContainer.innerHTML = "";

  state.files.forEach(item => {
    const card = document.createElement("article");
    card.id = item.id;
    card.className =
      "bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden";

    card.innerHTML = `
      <div class="p-4 border-b border-slate-100 flex items-center justify-between gap-3">
        <div class="min-w-0">
          <div class="font-semibold text-sm text-slate-800 truncate">${escapeHtml(item.file.name)}</div>
          <div class="text-xs text-slate-400 mt-0.5">
            Categoría: ${escapeHtml(categoryRules[item.category].label)}
          </div>
          <div data-role="duration" class="text-[11px] text-slate-400 mt-0.5">Tiempo de análisis: —</div>
          <details class="mt-1 text-[10px] text-slate-500"><summary class="cursor-pointer select-none">Tiempos por etapa</summary><div data-role="stage-times" class="mt-1 space-y-0.5"></div></details>
        </div>
        <span data-role="status"
          class="shrink-0 text-xs px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">
          Pendiente
        </span>
      </div>

      <div class="grid lg:grid-cols-2 gap-4 p-4">
        <div>
          <div class="ocr-image-stage rounded-xl border border-slate-200 bg-slate-50 overflow-hidden" data-ocr-stage>
            <img src="${item.imageUrl}" class="rounded-xl" data-ocr-image style="display:none" aria-hidden="true">
            <canvas class="ocr-overlay-canvas" data-ocr-overlay width="1" height="1" aria-hidden="true"></canvas>
          </div>
          <div class="ocr-overlay-legend mt-2 flex flex-wrap gap-2 text-slate-500">
            <span>▣ OCR</span><span>▣ Región</span><span>▣ Línea</span><span class="text-red-600">▣ Evidencia crítica</span>
          </div>
          <div data-role="final-summary" class="ocr-final-summary mt-3">
            <div class="flex items-center justify-between gap-2">
              <div class="text-xs font-bold text-slate-700">Resultado final</div>
              <span data-final-risk class="text-[10px] font-bold px-2 py-1 rounded-full bg-slate-100 text-slate-600">Pendiente</span>
            </div>
            <div data-final-decision class="text-base font-extrabold text-slate-800 mt-1">Pendiente de análisis</div>
            <div data-final-reasons class="text-[11px] text-slate-600 mt-1">Los hallazgos aparecerán aquí al terminar.</div>
          </div>
        </div>

        <div class="space-y-3">
          <details class="rounded-xl border border-slate-200 bg-white">
            <summary class="cursor-pointer select-none px-3 py-2 text-xs font-semibold text-slate-600">Texto OCR reconstruido</summary>
            <div class="p-3 pt-0">
              <textarea data-role="ocr" class="ocr-text-output w-full mt-1 border border-slate-200 rounded-xl p-3 bg-slate-50 text-slate-800" rows="6" readonly></textarea>
            </div>
          </details>

          <div data-role="ocr-enhanced" class="ocr-enhanced-panel rounded-xl border border-slate-200 bg-white overflow-hidden">
            <div class="px-4 pt-4 pb-2 flex items-center justify-between gap-2">
              <div class="ocr-section-title text-slate-800">OCR</div>
              <div class="text-[10px] font-medium text-slate-400">Diagnóstico técnico OCR</div>
            </div>
            <div class="px-4 pb-3">
              <div class="ocr-meta-grid">
                <div class="ocr-meta-item"><div class="ocr-meta-label">Estado</div><div class="ocr-meta-value" data-ocr-ui-state>Completado</div></div>
                <div class="ocr-meta-item"><div class="ocr-meta-label">Duración</div><div class="ocr-meta-value" data-ocr-ui-duration>—</div></div>
                <div class="ocr-meta-item"><div class="ocr-meta-label">Cobertura estructural</div><div class="ocr-meta-value" data-ocr-ui-coverage>—</div></div>
                <div class="ocr-meta-item"><div class="ocr-meta-label">Acuerdo de líneas</div><div class="ocr-meta-value" data-ocr-ui-agreement>—</div></div>
              </div>
            </div>

            <div class="px-4 pb-3">
              <div class="text-xs font-semibold text-slate-500 mb-2">Calidad</div>
              <div class="overflow-hidden rounded-lg border border-slate-200">
                <table class="w-full text-xs">
                  <thead class="bg-slate-50 text-slate-500">
                    <tr>
                      <th class="text-left px-3 py-2 font-semibold">Métrica</th>
                      <th class="text-right px-3 py-2 font-semibold">Resultado</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <tr><td class="px-3 py-2 text-slate-600">Palabras brutas detectadas</td><td data-ocr-detected class="px-3 py-2 text-right font-semibold text-slate-800">0</td></tr>
                    <tr><td class="px-3 py-2 text-slate-600">Candidatos OCR</td><td data-ocr-candidates class="px-3 py-2 text-right font-semibold text-slate-800">0</td></tr>
                    <tr><td class="px-3 py-2 text-slate-600">Palabras consolidadas</td><td data-ocr-consolidated class="px-3 py-2 text-right font-semibold text-slate-800">0</td></tr>
                    <tr><td class="px-3 py-2 text-slate-600">Líneas finales</td><td data-ocr-final-lines class="px-3 py-2 text-right font-semibold text-slate-800">0</td></tr>
                    <tr><td class="px-3 py-2 text-slate-600">Confianza global</td><td data-ocr-confidence class="px-3 py-2 text-right font-semibold text-slate-800">0%</td></tr>
                    <tr><td class="px-3 py-2 text-slate-600">Alta confianza</td><td data-ocr-high class="px-3 py-2 text-right font-semibold text-slate-800">0</td></tr>
                    <tr><td class="px-3 py-2 text-slate-600">Media</td><td data-ocr-medium class="px-3 py-2 text-right font-semibold text-slate-800">0</td></tr>
                    <tr><td class="px-3 py-2 text-slate-600">Baja</td><td data-ocr-low class="px-3 py-2 text-right font-semibold text-slate-800">0</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div data-ocr-review-alert class="mx-4 mb-3 hidden rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800"></div>
            <div data-ocr-review-list class="px-4 pb-3 hidden"></div>

            <div class="px-4 pb-3 grid gap-3">
              <div class="ocr-zone-card">
