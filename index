/* ============================================================
   10. SIMULADOR SEMÁNTICO
   ============================================================ */

function simulateCohere(payload) {
  const text = payload.banner.normalized_text;
  const category = payload.category.id;

  const semanticMatches = [];

  if (category === "glp1") {
    const patterns = [
      { words: ["perder peso", "perder kilos", "adelgazar"], reason: "posible promesa directa de pérdida de peso" },
      { words: ["rapido", "rápido", "en pocos dias", "en pocos días"], reason: "posible promesa de resultado rápido" },
      { words: ["sin esfuerzo", "sin dieta", "sin ejercicio"], reason: "posible promesa de resultado sin esfuerzo" },
      { words: ["milagro", "milagroso"], reason: "lenguaje milagroso" },
      { words: ["garantizado", "garantiza", "garantizado al 100"], reason: "resultado presentado como garantizado" }
    ];

    patterns.forEach(pattern => {
      if (pattern.words.some(word => text.includes(normalizeText(word)))) {
        semanticMatches.push({
          rule: pattern.reason,
          evidence: pattern.words.find(word => text.includes(normalizeText(word))) || ""
        });
      }
    });
  }

  if (category === "otc") {
    if (text.includes("garantizado") || text.includes("para siempre")) {
      semanticMatches.push({
        rule: "promesa absoluta",
        evidence: "lenguaje de garantía o permanencia"
      });
    }
  }

  if (category === "general") {
    if (text.includes("sin riesgo") || text.includes("sin efectos")) {
      semanticMatches.push({
        rule: "ausencia absoluta de riesgo/efectos",
        evidence: "afirmación absoluta"
      });
    }
  }

  const exactViolations = payload.deterministic_check.matched_rules.map(rule => ({
    rule,
    evidence: rule,
    reason: "Coincidencia exacta con una regla prohibida."
  }));

  const criticalMatches = (payload.deterministic_check.critical_matches || []).map(v => ({
    rule: v.rule,
    evidence: v.evidence,
    reason: "Evidencia OCR crítica detectada con proximidad espacial.",
    confidence: v.confidence
  }));

  const violations = [...exactViolations, ...semanticMatches, ...criticalMatches];

  let decision = "APPROVED";
  let risk = "LOW";

  if (violations.length) {
    decision = payload.deterministic_check.matched_rules.length ? "REJECTED" : "REVIEW";
    risk = payload.deterministic_check.matched_rules.length ? "HIGH" : "MEDIUM";
  }

  return {
    decision,
    risk_level: risk,
    compliant: decision === "APPROVED",
    violations,
    warnings: [],
    explanation:
      decision === "APPROVED"
        ? "No se detectaron infracciones evidentes en la evaluación local."
        : "Se detectaron expresiones que requieren rechazo o revisión regulatoria."
  };
}

