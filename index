/* ============================================================
   8. MOTOR DETERMINISTA
   ============================================================ */

function deterministicValidation(text, categoryKey, contextualText = "", criticalEvidence = []) {
  const normalized = normalizeText(text);
  const contextualNormalized = normalizeText(contextualText);
  const rules = categoryRules[categoryKey];

  const matchedRules = rules.forbidden.filter(rule => normalized.includes(normalizeText(rule)));
  const contextualMatches = rules.forbidden.filter(rule =>
    !matchedRules.includes(rule) && contextualNormalized.includes(normalizeText(rule))
  );

  const criticalMatches = (criticalEvidence || [])
    .filter(e => Array.isArray(e.tokens) && e.tokens.length >= 2)
    .map(e => ({ rule: e.tokens.join(" "), evidence: e.tokens.join(" "), confidence: e.confidence }));

  return {
    passed: matchedRules.length === 0 && contextualMatches.length === 0 && criticalMatches.length === 0,
    matchedRules,
    contextualMatches,
    criticalMatches,
    normalizedText: normalized,
    contextualNormalizedText: contextualNormalized
  };
}

