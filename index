/* ============================================================
   FASE 6 — DICCIONARIO CONTEXTUAL
   ============================================================
   El diccionario NO reemplaza el OCR bruto. Genera una capa secundaria
   de interpretación/corrección conservadora basada en el contexto del
   banner. Solo se aplica una corrección cuando la similitud y el contexto
   superan los umbrales definidos.
   ============================================================ */

const CONTEXT_DICTIONARY = {
  global: [
    "consulta a tu medico", "consulta a tu médico", "compra aqui", "compra aquí",
    "bajar de peso", "perder peso", "perdida de peso", "pérdida de peso",
    "suelta la culpa", "control de peso", "tratamiento", "medicamento", "medico", "médico",
    "farmacia", "laboratorio", "dosis", "capsulas", "cápsulas", "tabletas", "paciente",
    "advertencia", "precaucion", "precaución", "efectos secundarios", "uso indicado",
    "lee el instructivo", "mantener fuera del alcance de los niños"
  ],
  glp1: [
    "bajar de peso", "baja de peso", "control de peso", "perder peso", "pérdida de peso",
    "adelgazar", "tratamiento para el control de peso", "consulta a tu medico", "consulta a tu médico",
    "resultado garantizado", "sin esfuerzo", "sin dieta", "sin ejercicio", "quema grasa"
  ],
  otc: [
    "consulta a tu medico", "consulta a tu médico", "lee el instructivo", "dosis recomendada",
    "efectos secundarios", "contraindicaciones", "uso indicado", "advertencia", "precaución"
  ],
  general: [
    "consulta a tu medico", "consulta a tu médico", "control de peso", "compra aqui", "compra aquí",
    "resultados", "advertencia", "precaución"
  ]
};

function levenshtein(a,b){
  a=String(a||""); b=String(b||"");
  if(a===b)return 0; if(!a)return b.length; if(!b)return a.length;
  let prev=Array.from({length:b.length+1},(_,i)=>i);
  for(let i=1;i<=a.length;i++){
    const cur=[i];
    for(let j=1;j<=b.length;j++) cur[j]=Math.min(cur[j-1]+1,prev[j]+1,prev[j-1]+(a[i-1]===b[j-1]?0:1));
    prev=cur;
  }
  return prev[b.length];
}

function textSimilarity(a,b){
  a=normalizeText(a).replace(/[^a-z0-9áéíóúüñ]/g,"");
  b=normalizeText(b).replace(/[^a-z0-9áéíóúüñ]/g,"");
  if(!a||!b)return 0;
  if(a===b)return 1;
  const max=Math.max(a.length,b.length);
  return 1-levenshtein(a,b)/max;
}

function buildContextLexicon(category){
  const list=[...(CONTEXT_DICTIONARY.global||[]), ...(CONTEXT_DICTIONARY[category]||[])];
  return [...new Set(list.map(normalizeText).filter(Boolean))];
}

function applyContextualDictionary(ocr, category){
  const lexicon=buildContextLexicon(category);
  const words=(ocr.words||[]).map(w=>({
    ...w,
    normalized:normalizeText(w.text),
    compact:normalizeText(w.text).replace(/[^a-z0-9áéíóúüñ]/g,"")
  })).filter(w=>w.normalized);

  const corrections=[];
  const protectedTokens=new Set();

  // 1) Buscar frases sobre ventanas de palabras cercanas espacialmente.
  // Se permiten variantes OCR como BAJAR.DE / BAJARDEPESO.
  const ordered=[...words].sort((a,b)=>((a.bbox.y0+a.bbox.y1)/2)-((b.bbox.y0+b.bbox.y1)/2)||a.bbox.x0-b.bbox.x0);
  for(let i=0;i<ordered.length;i++){
    for(let len=1;len<=Math.min(6,ordered.length-i);len++){
      const slice=ordered.slice(i,i+len);
      if(!slice.length)continue;
      const yCenters=slice.map(w=>(w.bbox.y0+w.bbox.y1)/2);
      const heights=slice.map(w=>Math.max(1,w.bbox.y1-w.bbox.y0));
      const ySpread=Math.max(...yCenters)-Math.min(...yCenters);
      const hAvg=heights.reduce((a,b)=>a+b,0)/heights.length;
      if(ySpread>hAvg*0.9) continue;
      const phrase=slice.map(w=>w.text).join(" ");
      const compactPhrase=slice.map(w=>w.compact).join("");
      for(const target of lexicon){
        const targetCompact=target.replace(/[^a-z0-9áéíóúüñ]/g,"");
        const sim=textSimilarity(phrase,target);
        const compactSim=textSimilarity(compactPhrase,targetCompact);
        const contains=normalizeText(phrase).includes(target)||target.includes(normalizeText(phrase));
        const score=Math.max(sim,compactSim)+(contains?0.12:0);
        const confidence=slice.reduce((a,w)=>a+(Number(w.confidence)||0),0)/slice.length;
        const spatial=1-Math.min(1,ySpread/Math.max(1,hAvg));
        const finalScore=score*0.62+(confidence/100)*0.18+spatial*0.20;
        const threshold=target.split(" ").length>=2?0.76:0.86;
        if(finalScore>=threshold){
          const key=slice.map(w=>w.region+":"+w.bbox.x0+":"+w.bbox.y0).join("|")+"=>"+target;
          if(!corrections.some(c=>c.key===key)) corrections.push({key,raw:phrase,corrected:target,score:Math.round(finalScore*100),confidence:Math.round(confidence),tokens:slice.length,region:slice[0].region,bbox:{x0:Math.min(...slice.map(w=>w.bbox.x0)),y0:Math.min(...slice.map(w=>w.bbox.y0)),x1:Math.max(...slice.map(w=>w.bbox.x1)),y1:Math.max(...slice.map(w=>w.bbox.y1))}});
          slice.forEach(w=>protectedTokens.add(w));
        }
      }
    }
  }

  // 2) En esta fase NO corregimos palabras aisladas.
  // Una palabra aislada como “medicamento”, “farmacia” o “médico” puede ser
  // legítima y el diccionario no debe convertir ruido OCR en texto inventado.
  // Solo se permiten correcciones de frases de 2+ palabras con evidencia espacial.
  const phraseCorrections=corrections.filter(c=>c.tokens>=2);

  // 3) Seleccionar correcciones no conflictivas, favoreciendo frases largas.
  phraseCorrections.sort((a,b)=>b.tokens-a.tokens||b.score-a.score||b.corrected.length-a.corrected.length);
  const selected=[];
  for(const c of phraseCorrections){
    const overlaps=selected.some(s=>s.bbox&&c.bbox&&!(c.bbox.x1<s.bbox.x0||c.bbox.x0>s.bbox.x1||c.bbox.y1<s.bbox.y0||c.bbox.y0>s.bbox.y1));
    if(!overlaps) selected.push(c);
  }

  let contextualText=ocr.text||"";
  // Aplicar primero frases sobre el texto consolidado. También se contempla
  // el caso de OCR que unió palabras sin espacios.
  for(const c of selected.sort((a,b)=>b.raw.length-a.raw.length)){
    const raw=String(c.raw||"").trim();
    if(!raw)continue;
    const escaped=raw.replace(/[.*+?^${}()|[\]\\]/g,"\\$&");
    const re=new RegExp(escaped.replace(/\s+/g,"\\s*"),"giu");
    if(re.test(contextualText)) contextualText=contextualText.replace(re,c.corrected);
    else {
      const compactRaw=normalizeText(raw).replace(/[^a-z0-9áéíóúüñ]/g,"");
      const compactTarget=normalizeText(c.corrected).replace(/[^a-z0-9áéíóúüñ]/g,"");
      const compactRe=new RegExp(compactRaw.split("").map(ch=>ch.replace(/[.*+?^${}()|[\]\\]/g,"\\$&")).join("\\s*"),"giu");
      contextualText=contextualText.replace(compactRe,c.corrected);
    }
  }
  contextualText=contextualText.replace(/\s+([,.!?;:])/g,"$1").replace(/ {2,}/g," ").trim();
  // No degradar frases regulatorias recuperadas correctamente.
  const protectedPhrases=["bajar de peso","consulta a tu medico","consulta a tu médico","compra aqui","compra aquí"];
  for(const phrase of protectedPhrases){
    if(normalizeText(ocr.text).includes(normalizeText(phrase))){
      const re=new RegExp(normalizeText(phrase).split(" ").map(x=>x.replace(/[.*+?^${}()|[\]\\]/g,"\\$&")).join("\\s+"),"giu");
      contextualText=contextualText.replace(re,phrase);
    }
  }

  const contextualMatches=[];
  for(const target of lexicon){
    if(normalizeText(contextualText).includes(target)) contextualMatches.push(target);
  }

  return {
    rawText:ocr.text,
    contextualText,
    corrections:selected,
    contextualMatches:[...new Set(contextualMatches)],
    dictionarySize:lexicon.length
  };
}

// FASE 5 — CONSENSO ENTRE OCR
async function recognizeImage(worker, imageUrl, categoryKey = state.currentCategory, onStage = () => {}) {
  onStage("prepare", "active");
  const img = await new Promise((resolve, reject) => {
    const el = new Image();
    el.onload = () => resolve(el);
    el.onerror = () => reject(new Error("No se pudo cargar la imagen para OCR."));
    el.src = imageUrl;
  });
  onStage("prepare", "done");
  onStage("main", "active");

  const W = img.naturalWidth || img.width;
  const H = img.naturalHeight || img.height;
  const clamp = (v,a,b) => Math.max(a, Math.min(b,v));
  const localNorm = t => norm(t);
  const compact = t => norm(t).replace(/[^\p{L}\p{N}]+/gu,"");

  /*
    FASE 10 — OCR HÍBRIDO GEOMÉTRICO + ZONAS SEMÁNTICAS
    ----------------------------------------------------
    Cambio arquitectónico respecto de Fases 9/9.1:
    1) Tesseract entrega líneas/bloques directamente; ya no reconstruimos la
       línea principal únicamente agrupando palabras de forma manual.
    2) Cada línea se vuelve a leer desde la imagen original y desde un canvas.
    3) Se realizan sondas amplias de las zonas de titular para detectar
       evidencia crítica aunque la selección final haya perdido una palabra.
    4) La similitud contextual solo elige entre textos realmente producidos por
       OCR; nunca fabrica texto para el campo OCR.
  */

  const discoveryPasses = [
    {id:"global", label:"Bloques globales", x0:0, y0:0, x1:1, y1:1, scale:2.5, psm:"11", mode:"color", weight:1.00},
    {id:"headline", label:"Zona titular", x0:0.02, y0:0.18, x1:0.86, y1:0.70, scale:3.5, psm:"6", mode:"contrast", weight:1.16},
    {id:"headlineSparse", label:"Titular disperso", x0:0.02, y0:0.20, x1:0.86, y1:0.70, scale:3.5, psm:"11", mode:"contrast", weight:1.18},
    {id:"rightText", label:"Zona derecha", x0:0.48, y0:0.28, x1:0.99, y1:0.82, scale:3.5, psm:"11", mode:"contrast", weight:1.05},
    {id:"lower", label:"Zona inferior", x0:0.01, y0:0.72, x1:0.99, y1:0.99, scale:4.0, psm:"6", mode:"contrast", weight:1.04}
  ];

  function makeCanvas(r){
    const sx=Math.round(W*r.x0), sy=Math.round(H*r.y0);
    const sw=Math.max(1,Math.round(W*(r.x1-r.x0))), sh=Math.max(1,Math.round(H*(r.y1-r.y0)));
    const c=document.createElement("canvas");
    c.width=Math.max(64,Math.round(sw*r.scale));
    c.height=Math.max(64,Math.round(sh*r.scale));
    const ctx=c.getContext("2d",{willReadFrequently:true});
    ctx.imageSmoothingEnabled=true;
    ctx.drawImage(img,sx,sy,sw,sh,0,0,c.width,c.height);
    if(r.mode!=="color"){
      const d=ctx.getImageData(0,0,c.width,c.height), px=d.data;
      const factor=r.mode==="contrast"?1.42:1.12;
      for(let i=0;i<px.length;i+=4){
        const g=.299*px[i]+.587*px[i+1]+.114*px[i+2];
        const v=clamp((g-128)*factor+128,0,255);
        px[i]=px[i+1]=px[i+2]=v;
      }
      ctx.putImageData(d,0,0);
    }
    return {canvas:c,offsetX:sx,offsetY:sy,scale:r.scale};
  }

  function toGlobalBox(b,p){
    return {
      x0:(Number(b?.x0)||0)/p.scale+p.offsetX,
      y0:(Number(b?.y0)||0)/p.scale+p.offsetY,
      x1:(Number(b?.x1)||0)/p.scale+p.offsetX,
      y1:(Number(b?.y1)||0)/p.scale+p.offsetY
    };
  }

  function extractBlockLines(data, prepared, passId){
    const out=[];
    const blocks=Array.isArray(data?.blocks)?data.blocks:[];
    const pushLine=(line)=>{
      if(!line) return;
      const words=Array.isArray(line.words)?line.words:[];
      const cleanWords=words.map(w=>({
        text:String(w?.text||"").trim(),
        confidence:Number(w?.confidence)||0,
        bbox:toGlobalBox(w?.bbox||{},prepared)
      })).filter(w=>w.text && w.bbox.x1>w.bbox.x0 && w.bbox.y1>w.bbox.y0);
      const text=String(line.text||cleanWords.map(w=>w.text).join(" ")).replace(/[\r\n]+/g," ").replace(/\s+/g," ").trim();
      if(!text || !cleanWords.length) return;
      const bbox=cleanWords.reduce((b,w)=>({
        x0:Math.min(b.x0,w.bbox.x0), y0:Math.min(b.y0,w.bbox.y0),
        x1:Math.max(b.x1,w.bbox.x1), y1:Math.max(b.y1,w.bbox.y1)
      }),{x0:Infinity,y0:Infinity,x1:-Infinity,y1:-Infinity});
      out.push({text,confidence:Number(line.confidence)||cleanWords.reduce((a,w)=>a+w.confidence,0)/cleanWords.length,bbox,words:cleanWords,pass:passId});
    };
    for(const block of blocks){
      for(const para of (block.paragraphs||[])){
        for(const line of (para.lines||[])) pushLine(line);
      }
    }
    // Compatibilidad con versiones/salidas donde words vienen directamente.
    if(!out.length && Array.isArray(data?.lines)) data.lines.forEach(pushLine);
    if(!out.length && Array.isArray(data?.words)){
      const ws=data.words.map(w=>({text:String(w?.text||"").trim(),confidence:Number(w?.confidence)||0,bbox:toGlobalBox(w?.bbox||{},prepared)})).filter(w=>w.text);
      const byY=[];
      for(const w of ws){
        const cy=(w.bbox.y0+w.bbox.y1)/2, h=Math.max(4,w.bbox.y1-w.bbox.y0);
        let target=byY.find(l=>Math.abs(l.cy-cy)<=Math.max(7,h*.55));
        if(!target){target={cy,h,words:[]};byY.push(target);}
        target.words.push(w); target.cy=(target.cy*(target.words.length-1)+cy)/target.words.length; target.h=Math.max(target.h,h);
      }
      byY.forEach(l=>pushLine({text:l.words.sort((a,b)=>a.bbox.x0-b.bbox.x0).map(w=>w.text).join(" "),confidence:l.words.reduce((a,w)=>a+w.confidence,0)/l.words.length,words:l.words}));
    }
    return out;
  }

  const discoveryLines=[];
  const discoveryWords=[];
  const passStats=[];

  for(const p of discoveryPasses){
    const prepared=makeCanvas(p);
    try{
      await worker.setParameters({
        tessedit_pageseg_mode:p.psm,
        preserve_interword_spaces:"1",
        user_defined_dpi:"300",
        classify_enable_learning:"0"
      });
      const rr=await worker.recognize(prepared.canvas, {}, {text:true, blocks:true});
      const lines=extractBlockLines(rr?.data,prepared,p.id);
      lines.forEach(l=>{
        l.weight=p.weight;
        discoveryLines.push(l);
        l.words.forEach(w=>discoveryWords.push({...w,pass:p.id,weight:p.weight}));
      });
      const accepted=lines.reduce((n,l)=>n+l.words.length,0);
      const conf=lines.length?lines.reduce((a,l)=>a+l.confidence,0)/lines.length:0;
      passStats.push({id:p.id,label:p.label,raw:accepted,accepted:lines.length,confidence:Math.round(conf)});
    }catch(err){
      passStats.push({id:p.id,label:p.label,raw:0,accepted:0,confidence:0,error:String(err?.message||err)});
    }
  }

  function lineCompatibility(a,b){
    const ay=(a.bbox.y0+a.bbox.y1)/2, by=(b.bbox.y0+b.bbox.y1)/2;
    const ah=Math.max(5,a.bbox.y1-a.bbox.y0), bh=Math.max(5,b.bbox.y1-b.bbox.y0);
    const yOk=Math.abs(ay-by)<=Math.max(ah,bh)*.42;
    const x0=Math.max(a.bbox.x0,b.bbox.x0), x1=Math.min(a.bbox.x1,b.bbox.x1);
    const overlap=Math.max(0,x1-x0)/Math.max(1,Math.min(a.bbox.x1-a.bbox.x0,b.bbox.x1-b.bbox.x0));
    const centerClose=Math.abs(((a.bbox.x0+a.bbox.x1)/2)-((b.bbox.x0+b.bbox.x1)/2))<=Math.max(W*.06,ah*3);
    const samePass=a.pass && b.pass && a.pass===b.pass;
    return yOk && (overlap>=.30 || centerClose || samePass);
  }

  // Fusionamos la misma línea detectada por varias pasadas, conservando todas
  // las variantes para diagnóstico y para evidencia crítica.
  const merged=[];
  // El pase global se conserva para descubrimiento/evidencia, pero no gobierna
  // la reconstrucción estructural porque puede atravesar varias líneas físicas.
  const structuralDiscoveryLines = discoveryLines.filter(l=>l.pass !== "global");
  const ranked=[...structuralDiscoveryLines].sort((a,b)=>(b.confidence*b.weight+b.words.length*2)-(a.confidence*a.weight+a.words.length*2));
  for(const line of ranked){
    let target=merged.find(m=>lineCompatibility(m,line));
    if(!target){
      target={variants:[line],bbox:{...line.bbox},confidence:line.confidence,words:[...line.words]};
      merged.push(target);
    }else{
      target.variants.push(line);
      target.bbox={x0:Math.min(target.bbox.x0,line.bbox.x0),y0:Math.min(target.bbox.y0,line.bbox.y0),x1:Math.max(target.bbox.x1,line.bbox.x1),y1:Math.max(target.bbox.y1,line.bbox.y1)};
      target.confidence=Math.max(target.confidence,line.confidence);
      if(line.confidence>target.variants[0].confidence) target.words=line.words;
    }
  }

  const bands=merged.filter(m=>{
    const width=m.bbox.x1-m.bbox.x0, height=m.bbox.y1-m.bbox.y0;
    const wordCount=(m.words||[]).length;
    const giantVertical=height>Math.max(120,H*.16);
    const giantLine=wordCount>28 && width>W*.45;
    return width>=18 && height>=4 && m.bbox.y0>=0 && m.bbox.y1<=H && !giantVertical && !giantLine;
  }).sort((a,b)=>a.bbox.y0-b.bbox.y0 || a.bbox.x0-b.bbox.x0).slice(0,40);

  function cropLine(bbox,variant){
    const h=Math.max(8,bbox.y1-bbox.y0), width=Math.max(12,bbox.x1-bbox.x0);
    const padX=Math.max(18,Math.round(h*.75),Math.round(width*.10));
    const padY=Math.max(8,Math.round(h*.45));
    const sx=Math.max(0,bbox.x0-padX), sy=Math.max(0,bbox.y0-padY);
    const ex=Math.min(W,bbox.x1+padX), ey=Math.min(H,bbox.y1+padY);
    const sw=Math.max(1,ex-sx), sh=Math.max(1,ey-sy), scale=4, border=12;
    const c=document.createElement("canvas");
    c.width=Math.max(64,Math.round(sw*scale+border*2)); c.height=Math.max(40,Math.round(sh*scale+border*2));
    const ctx=c.getContext("2d",{willReadFrequently:true});
    ctx.fillStyle="#fff"; ctx.fillRect(0,0,c.width,c.height); ctx.imageSmoothingEnabled=true;
    ctx.drawImage(img,sx,sy,sw,sh,border,border,sw*scale,sh*scale);
    if(variant!=="color"){
      const d=ctx.getImageData(0,0,c.width,c.height),px=d.data;
      for(let i=0;i<px.length;i+=4){
        const g=.299*px[i]+.587*px[i+1]+.114*px[i+2];
        let v=g;
        if(variant==="gray") v=clamp((g-128)*1.40+128,0,255);
        if(variant==="threshold") v=g>154?255:0;
        if(variant==="soft-threshold") v=g>132?255:0;
        px[i]=px[i+1]=px[i+2]=v;
      }
      ctx.putImageData(d,0,0);
    }
    return {canvas:c,sx,sy,scale,border};
  }

  function phraseScore(text,target){
    const a=norm(text).split(/\s+/).filter(Boolean), b=norm(target).split(/\s+/).filter(Boolean);
    if(!a.length||!b.length)return 0;
    let best=0;
    for(let i=0;i<a.length;i++){
      const scores=[];
      for(let j=0;j<b.length;j++){
        const idx=Math.min(a.length-1,i+j);
        scores.push(textSimilarity(a[idx],b[j]));
      }
      best=Math.max(best,scores.reduce((x,y)=>x+y,0)/scores.length);
    }
    return best;
  }

  const criticalRules=(categoryRules[categoryKey]?.forbidden||[]).filter(r=>norm(r).split(/\s+/).length>=2);
  const lexicon=[
    "suelta la culpa","bajar de peso","ya esta en boca de todos","consulta a tu medico",
    "compra aqui","escanea y conoce los descuentos que hay para ti","material exclusivo",
    "medicamento","receta medica","consulte terminos y condiciones"
  ];

  function candidateScore(out,band){
    const text=String(out.text||"").replace(/\s+/g," ").trim();
    if(!text)return -Infinity;
    const conf=clamp(Number(out.confidence)||0,0,100);
    const alpha=(text.match(/[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]/g)||[]).length;
    const alphaRatio=alpha/Math.max(1,text.length);
    const noise=(text.match(/[|_~`@$#{}[\]\\]/g)||[]).length;
    const noisePenalty=Math.min(.35,noise/Math.max(8,text.length));
    let lex=0, fuzzy=0;
    for(const p of lexicon){
      const pn=norm(p);
      if(norm(text).includes(pn))lex++;
      fuzzy=Math.max(fuzzy,phraseScore(text,p));
    }
    for(const p of criticalRules) fuzzy=Math.max(fuzzy,phraseScore(text,p));
    const wordCount=text.split(/\s+/).filter(Boolean).length;
    const expected=Math.max(1,band.words?.length||wordCount);
    const lengthFit=Math.min(1,wordCount/expected);
    // En la reconstrucción 10.5.2 la evidencia léxica y la limpieza física
    // tienen prioridad sobre una diferencia pequeña de confianza. Esto evita
    // seleccionar una lectura larga y ruidosa que mezcla dos líneas cuando
    // otra lectura de la misma caja contiene una frase coherente.
    const phraseBonus=Math.min(34,lex*14);
    const fuzzyBonus=Math.min(24,fuzzy*24);
    return conf*.46+alphaRatio*8+lengthFit*5+phraseBonus+fuzzyBonus-noisePenalty*34;
  }

  const finalLines=[];
  const finalWords=[];
  const lineDiagnostics=[];

  for(let i=0;i<bands.length;i++){
    const band=bands[i], outputs=[];
    for(const variant of ["color","gray","threshold","soft-threshold"]){
      const prepared=cropLine(band.bbox,variant);
      for(const psm of ["7","13","6"]){
        try{
          await worker.setParameters({tessedit_pageseg_mode:psm,preserve_interword_spaces:"1",user_defined_dpi:"300",classify_enable_learning:"0"});
          const rr=await worker.recognize(prepared.canvas,{}, {text:true,blocks:true});
          const txt=String(rr?.data?.text||"").replace(/[\r\n]+/g," ").replace(/\s+/g," ").trim();
          const ws=(rr?.data?.words||[]).filter(w=>String(w.text||"").trim());
          const confs=ws.map(w=>Number(w.confidence)||0).filter(v=>v>0);
          const conf=confs.length?confs.reduce((a,b)=>a+b,0)/confs.length:Number(rr?.data?.confidence)||0;
          if(txt)outputs.push({text:txt,confidence:conf,variant,psm,data:rr.data,prepared});
        }catch(err){}
      }
    }

    // Segunda ruta: imagen original + rectangle nativo.
    try{
      const h=Math.max(6,band.bbox.y1-band.bbox.y0);
      const padX=Math.max(20,Math.round(h*.90));
      const padY=Math.max(7,Math.round(h*.40));
      const rectangle={left:Math.max(0,Math.floor(band.bbox.x0-padX)),top:Math.max(0,Math.floor(band.bbox.y0-padY)),width:Math.min(W,Math.ceil(band.bbox.x1+padX))-Math.max(0,Math.floor(band.bbox.x0-padX)),height:Math.min(H,Math.ceil(band.bbox.y1+padY))-Math.max(0,Math.floor(band.bbox.y0-padY))};
      for(const psm of ["7","13"]){
        await worker.setParameters({tessedit_pageseg_mode:psm,preserve_interword_spaces:"1",user_defined_dpi:"300",classify_enable_learning:"0"});
        const rr=await worker.recognize(img,{rectangle},{text:true,blocks:true});
        const txt=String(rr?.data?.text||"").replace(/[\r\n]+/g," ").replace(/\s+/g," ").trim();
        const ws=(rr?.data?.words||[]).filter(w=>String(w.text||"").trim());
        const confs=ws.map(w=>Number(w.confidence)||0).filter(v=>v>0);
        const conf=confs.length?confs.reduce((a,b)=>a+b,0)/confs.length:Number(rr?.data?.confidence)||0;
        if(txt)outputs.push({text:txt,confidence:conf,variant:"native-rectangle",psm,data:rr.data,prepared:{sx:rectangle.left,sy:rectangle.top,scale:1,border:0,native:true}});
      }
    }catch(err){}

    outputs.sort((a,b)=>candidateScore(b,band)-candidateScore(a,band)||b.confidence-a.confidence||b.text.length-a.text.length);
    const best=outputs[0];
    if(!best)continue;
    const cleanText=best.text.replace(/^[|_\-\s]+|[|_\-\s]+$/g,"").trim();
    if(!cleanText || candidateScore(best,band)<25)continue;

    const bbox={...band.bbox};
    const words=[];
    for(const w of (best.data?.words||[])){
      const t=String(w.text||"").trim(), c=Number(w.confidence)||0;
      if(!t||c<15)continue;
      const wb=w.bbox||{};
      words.push({
        text:t,confidence:c,region:"line-"+i,regionLabel:"Línea estructural",regionWeight:1.35,psm:Number(best.psm),
        bbox:{
          x0:(Number(wb.x0)-best.prepared.border)/best.prepared.scale+best.prepared.sx,
          y0:(Number(wb.y0)-best.prepared.border)/best.prepared.scale+best.prepared.sy,
          x1:(Number(wb.x1)-best.prepared.border)/best.prepared.scale+best.prepared.sx,
          y1:(Number(wb.y1)-best.prepared.border)/best.prepared.scale+best.prepared.sy
        }
      });
    }
    const avg=words.length?words.reduce((a,w)=>a+w.confidence,0)/words.length:best.confidence;
    finalLines.push({_cy:(bbox.y0+bbox.y1)/2,text:cleanText,source:"hybrid-line",confidence:Math.round(clamp(avg,0,100)),agreement:Math.round(clamp(candidateScore(best,band)*1.35,0,100)),bbox,alternatives:outputs.slice(0,6).map(o=>({text:o.text,confidence:Math.round(o.confidence),variant:o.variant,psm:o.psm})),tokenCount:words.length||cleanText.split(/\s+/).length});
    finalWords.push(...words);
    lineDiagnostics.push({line:i+1,bbox,selected:cleanText,confidence:Math.round(avg),candidates:outputs.length,variant:best.variant,psm:best.psm});
  }

  // Deduplicación conservadora: solo fusionamos si las cajas se superponen verticalmente.
  finalLines.sort((a,b)=>a._cy-b._cy||a.bbox.x0-b.bbox.x0);
  const dedup=[];
  for(const line of finalLines){
    const hit=dedup.find(x=>{
      const y=Math.abs(x._cy-line._cy), h=Math.max(5,Math.min(x.bbox.y1-x.bbox.y0,line.bbox.y1-line.bbox.y0));
      const x0=Math.max(x.bbox.x0,line.bbox.x0), x1=Math.min(x.bbox.x1,line.bbox.x1);
      return y<=h*.55 && x1>x0;
    });
    if(!hit)dedup.push(line);
    else if(line.confidence>hit.confidence){dedup[dedup.indexOf(hit)]=line;}
  }
  const structuralLines=dedup.sort((a,b)=>a._cy-b._cy||a.bbox.x0-b.bbox.x0);

  onStage("main", "done");
  onStage("regions", "active");

  /* Sondas críticas: se ejecutan sobre zonas amplias, sin reemplazar el OCR.
     Su única función es encontrar evidencia regulatoria que una línea mal
     segmentada pudiera haber perdido. */
  const criticalEvidence=[];
  const addCritical=(pair,confidence,bbox,type,evidenceText)=>criticalEvidence.push({tokens:pair,confidence:Math.round(clamp(confidence,0,100)),bbox:bbox||{x0:0,y0:0,x1:W,y1:H},type,evidence:evidenceText||pair.join(" ")});

  function detectCritical(text){
    const tokens=norm(text).split(/\s+/).filter(Boolean);
    for(const rule of criticalRules){
      const target=norm(rule).split(/\s+/).filter(Boolean);
      if(target.length<2)continue;
      for(let i=0;i<tokens.length;i++){
        let score=0, ok=true;
        for(let j=0;j<target.length;j++){
          const idx=i+j;
          if(idx>=tokens.length){ok=false;break;}
          score+=textSimilarity(tokens[idx],target[j]);
        }
        score/=target.length;
        if(ok&&score>=.72)return {tokens:target,score:score*100,rule};
      }
      if(phraseScore(text,rule)>=.78)return {tokens:target,score:phraseScore(text,rule)*100,rule};
    }
    return null;
  }

  for(const line of structuralLines){
    const h=detectCritical(line.text);
    if(h)addCritical(h.tokens,h.score,line.bbox,"structural-selected",line.text);
    for(const alt of (line.alternatives||[])){
      const ah=detectCritical(alt.text);
      if(ah)addCritical(ah.tokens,ah.score,line.bbox,"structural-alternative",alt.text);
    }
  }
  for(const line of discoveryLines){
    const h=detectCritical(line.text);
    if(h)addCritical(h.tokens,h.score,line.bbox,"discovery-line",line.text);
  }

  // Probes amplias para cada regla crítica de dos o más tokens.
  let criticalProbeCount=0;
  if(criticalRules.length){
    const probes=[
      {id:"critical-main",x0:.02,y0:.22,x1:.90,y1:.70,scale:4,psm:"6"},
      {id:"critical-sparse",x0:.02,y0:.20,x1:.92,y1:.72,scale:4,psm:"11"},
      {id:"critical-center",x0:.12,y0:.30,x1:.80,y1:.68,scale:4.5,psm:"11"}
    ];
    // Barrido de bandas horizontales: evita que una fotografía/elemento gráfico
    // dentro de una zona amplia impida a PSM 7 aislar una frase crítica.
    // Es una sonda de evidencia, NO reemplaza el OCR estructural final.
    for(let k=0;k<6;k++){
      const y0=.30+k*.055;
      probes.push({id:"critical-band-"+k,x0:.08,y0,x1:.76,y1:Math.min(.70,y0+.115),scale:4.5,psm:"7"});
    }
    criticalProbeCount=probes.length;
    for(const q of probes){
      try{
        const prepared=makeCanvas({...q,mode:"contrast"});
        await worker.setParameters({tessedit_pageseg_mode:q.psm,preserve_interword_spaces:"1",user_defined_dpi:"300",classify_enable_learning:"0"});
        const rr=await worker.recognize(prepared.canvas,{}, {text:true,blocks:true});
        const txt=String(rr?.data?.text||"").replace(/[\r\n]+/g," ").replace(/\s+/g," ").trim();
        const conf=Number(rr?.data?.confidence)||0;
        for(const rule of criticalRules){
          const score=phraseScore(txt,rule);
          if(score>=.68){
            addCritical(norm(rule).split(/\s+/),Math.max(conf,score*100),{x0:W*q.x0,y0:H*q.y0,x1:W*q.x1,y1:H*q.y1},"critical-probe",txt);
          }
        }
      }catch(err){}
    }
  }

  // Evidencia espacial con palabras de TODAS las pasadas de descubrimiento.
  const allWords=discoveryWords.map(w=>({...w,n:norm(w.text)})).filter(w=>w.n);
  for(const rule of criticalRules){
    const target=norm(rule).split(/\s+/).filter(Boolean);
    if(target.length<2)continue;
    for(let i=0;i<allWords.length;i++){
      if(textSimilarity(allWords[i].n,target[0])<.80)continue;
      for(let j=i+1;j<Math.min(allWords.length,i+8);j++){
        if(textSimilarity(allWords[j].n,target[target.length-1])<.80)continue;
        const a=allWords[i],b=allWords[j];
        const ygap=Math.abs(((a.bbox.y0+a.bbox.y1)/2)-((b.bbox.y0+b.bbox.y1)/2));
        const xgap=Math.abs(((a.bbox.x0+a.bbox.x1)/2)-((b.bbox.x0+b.bbox.x1)/2));
        if(ygap<=Math.max(H*.06,50)&&xgap<=Math.max(W*.38,280)){
          const score=(textSimilarity(a.n,target[0])+textSimilarity(b.n,target[target.length-1]))/2;
          if(score>=.80)addCritical(target,score*100,{x0:Math.min(a.bbox.x0,b.bbox.x0),y0:Math.min(a.bbox.y0,b.bbox.y0),x1:Math.max(a.bbox.x1,b.bbox.x1),y1:Math.max(a.bbox.y1,b.bbox.y1)},"spatial-discovery",`${a.text} ... ${b.text}`);
        }
      }
    }
  }

  /*
     FASE 10.1 — CONSOLIDACIÓN / RECONSTRUCCIÓN
     ---------------------------------------------
     No confundimos tres niveles distintos:
       1) rawWords: todas las palabras devueltas por las pasadas de descubrimiento.
       2) candidateWords: candidatos de descubrimiento + líneas estructurales.
       3) consolidatedWords: una representación por palabra física, fusionada por
          proximidad espacial y similitud textual.
     Las alternativas descartadas se conservan en discardedAlternatives para auditoría.
  */
  function boxCenter(b){ return {x:(b.x0+b.x1)/2,y:(b.y0+b.y1)/2}; }
  function boxIoU(a,b){
    const x0=Math.max(a.x0,b.x0), y0=Math.max(a.y0,b.y0), x1=Math.min(a.x1,b.x1), y1=Math.min(a.y1,b.y1);
    const inter=Math.max(0,x1-x0)*Math.max(0,y1-y0);
    const aa=Math.max(1,(a.x1-a.x0)*(a.y1-a.y0)), ab=Math.max(1,(b.x1-b.x0)*(b.y1-b.y0));
    return inter/Math.max(1,aa+ab-inter);
  }
  function wordCompatibility(a,b){
    const ac=boxCenter(a.bbox), bc=boxCenter(b.bbox);
    const aw=Math.max(4,a.bbox.x1-a.bbox.x0), bw=Math.max(4,b.bbox.x1-b.bbox.x0);
    const ah=Math.max(5,a.bbox.y1-a.bbox.y0), bh=Math.max(5,b.bbox.y1-b.bbox.y0);
    const h=Math.max(ah,bh), w=Math.max(aw,bw);
    const textSim=textSimilarity(a.text,b.text);
    const iou=boxIoU(a.bbox,b.bbox);
    const verticalOverlap=Math.max(0,Math.min(a.bbox.y1,b.bbox.y1)-Math.max(a.bbox.y0,b.bbox.y0))/Math.max(1,Math.min(ah,bh));
    const centerDist=Math.hypot(ac.x-bc.x,ac.y-bc.y);
    const samePhysicalWord = verticalOverlap>=0.45 && Math.abs(ac.y-bc.y)<=h*0.65 && centerDist<=Math.max(12,w*0.55) && (iou>=0.08 || Math.abs(ac.x-bc.x)<=Math.max(10,Math.min(aw,bw)*0.45));
    const sameLineNear = Math.abs(ac.y-bc.y)<=h*0.65 && Math.abs(ac.x-bc.x)<=Math.max(16,w*0.9) && iou>=0.02 && textSim>=0.72;
    return samePhysicalWord || sameLineNear || (iou>=0.32 && textSim>=0.45);
  }
  function candidateQuality(w){
    const c=clamp(Number(w.confidence)||0,0,100);
    const source=String(w.source||w.variant||w.pass||"");
    const sourceBoost=source.includes("hybrid-line")?8:(source.includes("native-rectangle")?6:0);
    const t=String(w.text||"").trim();
    const alpha=(t.match(/[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]/g)||[]).length;
    const noise=(t.match(/[|_~`@$#{}[\]\\]/g)||[]).length;
    const shortPenalty=t.length<=2?14:(t.length===3?4:0);
    const alphaRatio=alpha/Math.max(1,t.length);
    // En una misma caja física preferimos una lectura suficientemente completa;
    // un fragmento de 1–2 caracteres no debe desplazar a "médico", "consulta", etc.
    return c+sourceBoost+Math.min(8,alphaRatio*8)+Math.min(6,Math.log1p(t.length)*2)-shortPenalty-Math.min(8,noise);
  }

  onStage("regions", "done");
  onStage("consolidate", "active");

  const rawWords=discoveryWords.map(w=>({...w,source:"discovery",normalized:norm(w.text)})).filter(w=>w.normalized);
  const candidateWords=[
    ...rawWords,
    ...finalWords.map(w=>({...w,source:w.source||"hybrid-line",normalized:norm(w.text)})).filter(w=>w.normalized)
  ];

  const clusters=[];
  for(const candidate of candidateWords){
    let hit=null, hitScore=-1;
    for(const cluster of clusters){
      const representative=cluster.best;
      if(!wordCompatibility(candidate,representative)) continue;
      const score=textSimilarity(candidate.text,representative.text)*.65+boxIoU(candidate.bbox,representative.bbox)*.35;
      if(score>hitScore){hit=cluster;hitScore=score;}
    }
    if(!hit){
      clusters.push({best:candidate,items:[candidate]});
    }else{
      hit.items.push(candidate);
      if(candidateQuality(candidate)>candidateQuality(hit.best)) hit.best=candidate;
    }
  }
  const consolidatedWords=clusters.map((cluster,idx)=>{
    const best=cluster.best;
    return {...best,clusterId:`w-${idx+1}`,sources:[...new Set(cluster.items.map(x=>String(x.source||x.pass||"ocr")))],alternatives:cluster.items.filter(x=>x!==best).map(x=>({text:x.text,confidence:Math.round(Number(x.confidence)||0),source:x.source||x.pass||"ocr"})).slice(0,8),evidenceCount:cluster.items.length};
  }).sort((a,b)=>a.bbox.y0-b.bbox.y0||a.bbox.x0-b.bbox.x0);

  const finalWordKeys=new Set(consolidatedWords.map(w=>w.clusterId));
  const discardedAlternatives=Math.max(0,candidateWords.length-consolidatedWords.length);

  function lineTextSimilarity(a,b){
    const na=norm(a), nb=norm(b);
    if(!na||!nb)return 0;
    const ta=na.split(/\s+/), tb=nb.split(/\s+/);
    const overlap=ta.filter(x=>tb.some(y=>textSimilarity(x,y)>=.78)).length/Math.max(ta.length,tb.length);
    return Math.max(textSimilarity(na,nb),overlap);
  }
  function lineCompatibility10(a,b){
    const ac=boxCenter(a.bbox), bc=boxCenter(b.bbox);
    const ah=Math.max(5,a.bbox.y1-a.bbox.y0), bh=Math.max(5,b.bbox.y1-b.bbox.y0);
    const yClose=Math.abs(ac.y-bc.y)<=Math.max(ah,bh)*.8;
    const x0=Math.max(a.bbox.x0,b.bbox.x0), x1=Math.min(a.bbox.x1,b.bbox.x1);
    const overlap=Math.max(0,x1-x0)/Math.max(1,Math.min(a.bbox.x1-a.bbox.x0,b.bbox.x1-b.bbox.x0));
    return yClose && (overlap>=.12 || lineTextSimilarity(a.text,b.text)>=.62);
  }

  // Reconstrucción final: una sola línea por grupo físico. Si dos líneas se
  // repiten, conservamos la de mayor calidad y las demás quedan como variantes.
  const lineClusters=[];
  for(const line of structuralLines){
    let hit=null;
    for(const cluster of lineClusters){
      if(lineCompatibility10(line,cluster.best)){hit=cluster;break;}
    }
    if(!hit) lineClusters.push({best:line,items:[line]});
    else{
      hit.items.push(line);
      const score=(x)=>clamp(Number(x.confidence)||0,0,100)+Math.min(12,String(x.text||"").length/12);
      if(score(line)>score(hit.best)) hit.best=line;
    }
  }
  const reconstructedLines=lineClusters.map(cluster=>{
    const best=cluster.best;
    const alternatives=[...cluster.items.filter(x=>x!==best).map(x=>({text:x.text,confidence:x.confidence,source:x.source||"hybrid-line"})),...(best.alternatives||[])];
    return {...best,alternatives,sourceCount:cluster.items.length};
  }).sort((a,b)=>a._cy-b._cy||a.bbox.x0-b.bbox.x0);

  // Reconstrucción semántico-espacial 10.2. Se construye desde las palabras
  // consolidadas, no desde una línea OCR completa. Las evidencias críticas se
  // reincorporan sólo cuando ya fueron detectadas por OCR/sondas espaciales.
    onStage("consolidate", "done");
  onStage("reconstruct", "active");

function reconstructFinalText(lines, criticals, words){
    // FASE 10.5.3 — POSICIÓN FÍSICA DETERMINISTA
    // Una posición física sólo puede aportar una palabra final. Las lecturas
    // alternativas permanecen en consolidatedWords/alternatives y no se mezclan.
    const clean = v => String(v||'')
      .replace(/[|_~`@$#{}\\]/g,' ')
      .replace(/\s+([,.!?;:])/g,'$1')
      .replace(/\s+/g,' ').trim();
    const sim=(a,b)=>{const na=norm(a),nb=norm(b);return !na||!nb?0:(na===nb?1:textSimilarity(na,nb));};
    const area = b => { const cx=((b.x0+b.x1)/2)/W, cy=((b.y0+b.y1)/2)/H;
      return cy<.20?'brand':cy<.48?'headline':cy<.72?'middle':'legal'; };
    const noise = t => {
      const s=String(t||'').trim();
      const letters=(s.match(/[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]/g)||[]).length;
      const weird=(s.match(/[^A-Za-zÁÉÍÓÚÜÑáéíóúüñ0-9\s.,!?;:'’-]/g)||[]).length;
      return weird*2 + (letters<2?8:0) + (s.length<=2?5:0);
    };
    const scoreWord=w=>{
      const t=clean(w.text), c=clamp(Number(w.confidence)||0,0,100);
      let q=c*.72-noise(t)*2;
      const n=norm(t);
      if(criticalRules.some(p=>n===norm(p)||n.includes(norm(p)))) q+=24;
      if(lexicon.some(p=>n===norm(p))) q+=16;
      if(t.length>=3) q+=4;
      return q;
    };

    const valid=(words||[]).filter(w=>w?.bbox&&clean(w.text)&&
      Number.isFinite(+w.bbox.x0)&&Number.isFinite(+w.bbox.y0)&&
      +w.bbox.x1>+w.bbox.x0&&+w.bbox.y1>+w.bbox.y0);

    // 1. Resolver candidatos que ocupan la misma posición física.
    // Centro + tamaño + solapamiento: evitamos que lecturas de líneas vecinas
    // terminen en el mismo cluster sólo porque tienen texto parecido.
    const clusters=[];
    for(const w of valid){
      const b=w.bbox, cx=(b.x0+b.x1)/2, cy=(b.y0+b.y1)/2;
      const wh=Math.max(5,b.y1-b.y0), ww=Math.max(5,b.x1-b.x0);
      let best=null, bestScore=-Infinity;
      for(const g of clusters){
        const a=g.best.bbox, acx=(a.x0+a.x1)/2, acy=(a.y0+a.y1)/2;
        const ah=Math.max(5,a.y1-a.y0), aw=Math.max(5,a.x1-a.x0);
        const dy=Math.abs(cy-acy), dx=Math.abs(cx-acx);
        const inter=Math.max(0,Math.min(a.x1,b.x1)-Math.max(a.x0,b.x0))*Math.max(0,Math.min(a.y1,b.y1)-Math.max(a.y0,b.y0));
        const iou=inter/Math.max(1,aw*ah+ww*wh-inter);
        const sameLine=dy<=Math.max(4,Math.min(wh,ah)*.55);
        const centerNear=dx<=Math.max(10,Math.min(ww,aw)*.75);
        const textNear=sim(w.text,g.best.text)>=.82;
        if(!(iou>=.20 || (sameLine&&centerNear&&textNear))) continue;
        const sc=iou*3+(sameLine?1:0)+(textNear?1:0)-dy/Math.max(5,ah);
        if(sc>bestScore){best=g;bestScore=sc;}
      }
      if(best){best.items.push(w); if(scoreWord(w)>scoreWord(best.best)) best.best=w;}
      else clusters.push({best:w,items:[w]});
    }

    const chosen=clusters.map((g,i)=>{
      const b=g.best.bbox;
      return {...g.best,text:clean(g.best.text),clusterId:`physical-${i+1}`,
        alternatives:g.items.filter(x=>x!==g.best).map(x=>({text:clean(x.text),confidence:Math.round(+x.confidence||0),source:x.source||'ocr'})).slice(0,8),
        evidenceCount:g.items.length,area:area(b)};
    }).filter(w=>clean(w.text));

    // 2. Eliminar basura diminuta salvo que sea parte de una palabra/frase
    // conocida o tenga respaldo físico fuerte.
    const usable=chosen.filter(w=>{
      const t=clean(w.text), n=norm(t), h=w.bbox.y1-w.bbox.y0;
      if(t.length<=2 && !/^(a|y|o|e|de|en|el|la|tu|un)$/i.test(t)) return false;
      if(noise(t)>10 && !lexicon.some(p=>norm(p).includes(n)) && !criticalRules.some(p=>norm(p).includes(n))) return false;
      return h>=4;
    });

    // 3. Agrupar por líneas físicas. La tolerancia depende de la altura real de
    // la tipografía; no usamos una tolerancia grande que pueda fusionar líneas.
    const linesOut=[];
    for(const w of usable.sort((a,b)=>a.bbox.y0-b.bbox.y0||a.bbox.x0-b.bbox.x0)){
      const cy=(w.bbox.y0+w.bbox.y1)/2, h=Math.max(5,w.bbox.y1-w.bbox.y0);
      let target=null,best=Infinity;
      for(const l of linesOut){
        const dy=Math.abs(cy-l.cy), tol=Math.max(4,Math.min(h,l.height)*.38);
        if(dy>tol) continue;
        const last=l.words[l.words.length-1];
        const gap=last? w.bbox.x0-last.bbox.x1:0;
        // Permitir grandes separaciones en titulares, pero jamás saltar sobre
        // otra línea por una tolerancia vertical amplia.
        const maxGap=Math.max(80,h*5.5);
        if(gap < -Math.max(4,h*.25) || gap>maxGap) continue;
        const sc=dy/Math.max(4,tol)+(gap>0?gap/maxGap:0);
        if(sc<best){best=sc;target=l;}
      }
      if(!target){target={cy,height:h,words:[]};linesOut.push(target);}
      target.words.push(w);
      target.words.sort((a,b)=>a.bbox.x0-b.bbox.x0);
      target.cy=target.words.reduce((s,x)=>s+(x.bbox.y0+x.bbox.y1)/2,0)/target.words.length;
      target.height=Math.max(...target.words.map(x=>x.bbox.y1-x.bbox.y0));
    }

    // 4. Construir cada línea desde las palabras ganadoras. Los espacios se
    // derivan del hueco real entre cajas, no de la lectura textual de Tesseract.
    const reconstructed=linesOut.map((l,i)=>{
      const ws=l.words.sort((a,b)=>a.bbox.x0-b.bbox.x0);
      let text='';
      for(let j=0;j<ws.length;j++){
        const w=ws[j];
        if(j){const prev=ws[j-1], gap=w.bbox.x0-prev.bbox.x1;
          text += gap>Math.max(3,(w.bbox.y1-w.bbox.y0)*.18)?' ':' ';
        }
        text += clean(w.text);
      }
      const bbox=ws.reduce((b,w)=>({x0:Math.min(b.x0,w.bbox.x0),y0:Math.min(b.y0,w.bbox.y0),x1:Math.max(b.x1,w.bbox.x1),y1:Math.max(b.y1,w.bbox.y1)}),{x0:Infinity,y0:Infinity,x1:-Infinity,y1:-Infinity});
      return {text:clean(text),bbox,confidence:ws.reduce((s,w)=>s+(+w.confidence||0),0)/Math.max(1,ws.length),agreement:100,source:'physical-word-reconstruction',words:ws,sourceCount:ws.length,_order:i};
    }).filter(l=>l.text);

    // 5. No fusionar líneas sólo por similitud textual. Sólo eliminamos una
    // duplicación cuando las cajas físicas están realmente en la misma zona.
    const unique=[];
    for(const l of reconstructed.sort((a,b)=>a.bbox.y0-b.bbox.y0||a.bbox.x0-b.bbox.x0)){
      const dup=unique.find(x=>{
        const xa=x.bbox, lb=l.bbox;
        const cyA=(xa.y0+xa.y1)/2,cyB=(lb.y0+lb.y1)/2;
        const h=Math.max(5,Math.min(xa.y1-xa.y0,lb.y1-lb.y0));
        const overlap=Math.max(0,Math.min(xa.x1,lb.x1)-Math.max(xa.x0,lb.x0))/Math.max(1,Math.min(xa.x1-xa.x0,lb.x1-lb.x0));
        return Math.abs(cyA-cyB)<=h*.45 && overlap>=.35 && sim(x.text,l.text)>=.80;
      });
      if(!dup) unique.push(l);
      else if(l.confidence>dup.confidence) Object.assign(dup,l);
    }

    // 6. Evidencia crítica: sólo se reintegra si la propia geometría la apoya.
    for(const e of (criticals||[])){
      const phrase=clean(e.tokens?.join(' ')||e.evidence||''); if(!phrase) continue;
      const eb=e.bbox||{};
      const hit=unique.find(l=>{
        const lb=l.bbox||{}, ly=(lb.y0+lb.y1)/2, ey=(+eb.y0||0 + +eb.y1||0)/2;
        return Math.abs(ly-ey)<=Math.max(60,(lb.y1-lb.y0)*1.5) && sim(l.text,phrase)>=.72;
      });
      if(hit) hit.criticalEvidence=true;
      else unique.push({text:phrase,bbox:eb,confidence:+e.confidence||0,agreement:100,source:'critical-evidence',criticalEvidence:true,words:[]});
    }
    return unique.sort((a,b)=>a.bbox.y0-b.bbox.y0||a.bbox.x0-b.bbox.x0);
  }

  const finalText = reconstructFinalText(structuralLines, criticalEvidence, consolidatedWords).map(l=>l.text).join("\n");
  onStage("reconstruct", "done");
  onStage("validate", "active");

  const selected=consolidatedWords.length?consolidatedWords:finalWords.length?finalWords:rawWords;
  const averageConfidence=selected.length?Math.round(selected.reduce((a,w)=>a+(Number(w.confidence)||0),0)/selected.length):0;
  const high=selected.filter(w=>Number(w.confidence)>=80).length;
  const low=selected.filter(w=>Number(w.confidence)<50).length;
  const medium=Math.max(0,selected.length-high-low);
  const reviewWords=selected.filter(w=>Number(w.confidence)<58);
  const reviewFragments=reconstructedLines.filter(line=>reviewWords.some(w=>w.bbox.y0>=line.bbox.y0-12&&w.bbox.y1<=line.bbox.y1+12)).map(line=>({text:line.text,words:reviewWords.filter(w=>w.bbox.y0>=line.bbox.y0-12&&w.bbox.y1<=line.bbox.y1+12).length,confidence:Math.round(reviewWords.filter(w=>w.bbox.y0>=line.bbox.y0-12&&w.bbox.y1<=line.bbox.y1+12).reduce((a,w)=>a+w.confidence,0)/Math.max(1,reviewWords.filter(w=>w.bbox.y0>=line.bbox.y0-12&&w.bbox.y1<=line.bbox.y1+12).length))})).slice(0,8);

  // Una evidencia crítica se considera la misma si pertenece a la misma regla
  // y está espacialmente próxima, independientemente de la ruta que la encontró.
  function criticalRuleText(e){ return norm(e.tokens?.join(" ")||e.evidence||""); }
  function criticalSpatiallySame(a,b){
    const aa=a.bbox||{}, bb=b.bbox||{};
    const ac=boxCenter(aa), bc=boxCenter(bb);
    const dx=Math.abs(ac.x-bc.x), dy=Math.abs(ac.y-bc.y);
    const sameRule=criticalRuleText(a)===criticalRuleText(b);
    return sameRule && dx<=Math.max(90,W*.14) && dy<=Math.max(90,H*.16);
  }
  const criticalClusters=[];
  for(const e of criticalEvidence){
    let hit=criticalClusters.find(c=>criticalSpatiallySame(c.best,e));
    if(!hit){hit={best:e,items:[e]};criticalClusters.push(hit);}
    else{hit.items.push(e);if(Number(e.confidence)>Number(hit.best.confidence))hit.best=e;}
  }
  const uniqueCritical=criticalClusters.map(c=>({...c.best,sources:[...new Set(c.items.map(e=>e.type))],sourceCount:c.items.length,evidenceVariants:[...new Set(c.items.map(e=>e.evidence).filter(Boolean))].slice(0,8)}));
  onStage("validate", "done");
  const agreementOverall=reconstructedLines.length?Math.round(reconstructedLines.reduce((a,l)=>a+Math.min(100,l.confidence),0)/reconstructedLines.length):0;
  const textConsensus=reconstructedLines.length?Math.round(reconstructedLines.reduce((a,l)=>a+Math.min(100,l.agreement||0),0)/reconstructedLines.length):0;

  return {
    version:"10.5-fase-reconstruccion-palabra-geometria",
    text:finalText,
    rawConsensusText:discoveryLines.map(l=>l.text).join("\n"),
    rawWords,
    candidateWords,
    words:selected,
    consolidatedWords,
    discardedAlternatives,
    passStats,
    averageConfidence,
    agreementOverall,
    textConsensus,
    metrics:{
      structuralCoverage: Math.min(100, Math.round((reconstructedLines.length / Math.max(1, bands.length)) * 100)),
      lineAgreement: textConsensus
    },
    imageWidth: W,
    imageHeight: H,
    confidenceBuckets:{high,medium,low},
    lowConfidenceWords:reviewWords,
    reviewFragments,
    detectedWordCount:rawWords.length,
    candidateWordCount:candidateWords.length,
    consolidatedWordCount:consolidatedWords.length,
    finalLineCount:reconstructedLines.length,
    consensusLines:reconstructedLines,
    criticalEvidence:uniqueCritical,
    criticalEvidenceRawCount:criticalEvidence.length,
    regions:discoveryPasses,
    structuralDiagnostics:lineDiagnostics,
    structuralBandCount:bands.length,
    criticalProbeCount,
    audit:{discardedAlternatives,rawWordInstances:rawWords.length,candidateWordInstances:candidateWords.length,consolidatedWordInstances:consolidatedWords.length}
  };
}

/* Global OCR normalization helper — available to all render/validation scopes. */
function norm(t = "") {
  return String(t || "").toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^\p{L}\p{N}%.-]+/gu, " ")
    .replace(/\s+/g, " ")
    .trim();
}

/* ============================================================
   13. RESULTADOS
   ============================================================ */

function applyCriticalEvidenceOverride(validation) {
  const critical = Array.isArray(validation?.criticalEvidence) ? validation.criticalEvidence : [];
  if (critical.length) {
    return { ...validation, passed: false, risk: "HIGH", severity: "HIGH", status: "REJECTED", critical: true };
  }
  return validation;
}

// CRITICAL EVIDENCE OVERRIDE: any confirmed critical regulatory evidence rejects.

function renderOCROverlay(card, item, ocr) {
  const canvas = card.querySelector('[data-ocr-overlay]');
  const img = card.querySelector('[data-ocr-image]');
  if (!canvas || !img || !ocr) return;

  const W = Number(ocr.imageWidth || ocr.width || img.naturalWidth || 1);
  const H = Number(ocr.imageHeight || ocr.height || img.naturalHeight || 1);
  if (!(W > 0 && H > 0)) return;

  // IMPORTANTE: el canvas ahora ES la superficie visual de la imagen.
  // No usamos position:absolute ni object-fit. Dibujamos la imagen original
  // y los boxes dentro del mismo canvas y en las mismas coordenadas OCR.
  const paint = () => {
    const naturalW = img.naturalWidth || W;
    const naturalH = img.naturalHeight || H;
    if (!(naturalW > 0 && naturalH > 0)) return;

    canvas.width = Math.round(naturalW);
    canvas.height = Math.round(naturalH);
    canvas.style.aspectRatio = `${naturalW} / ${naturalH}`;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.clearRect(0, 0, naturalW, naturalH);

    // La imagen y el OCR se consideran en el mismo espacio. Si Tesseract
    // trabajó sobre una copia con exactamente estas dimensiones, scale=1.
    const sx = naturalW / W;
    const sy = naturalH / H;
    ctx.drawImage(img, 0, 0, naturalW, naturalH);

    const clampBox = (b) => {
      if (!b) return null;
      const vals = ['x0','y0','x1','y1'].map(k => Number(b[k]));
      if (vals.some(v => !Number.isFinite(v))) return null;
      let [x0,y0,x1,y1] = vals;
      x0 *= sx; x1 *= sx; y0 *= sy; y1 *= sy;
      const ax = Math.max(0, Math.min(naturalW, Math.min(x0,x1)));
      const ay = Math.max(0, Math.min(naturalH, Math.min(y0,y1)));
      const bx = Math.max(0, Math.min(naturalW, Math.max(x0,x1)));
      const by = Math.max(0, Math.min(naturalH, Math.max(y0,y1)));
      if (bx-ax < 2 || by-ay < 2) return null;
      return {x0:ax,y0:ay,x1:bx,y1:by};
    };

    const drawBox = (b, stroke, fill, label) => {
      const box = clampBox(b);
      if (!box) return;
      const x=box.x0, y=box.y0, w=box.x1-box.x0, h=box.y1-box.y0;
      ctx.save();
      ctx.lineWidth = Math.max(2, naturalW / 700);
      ctx.strokeStyle = stroke;
      ctx.fillStyle = fill;
      ctx.fillRect(x,y,w,h);
      ctx.strokeRect(x,y,w,h);
      if (label) {
        const fontSize = Math.max(10, Math.min(18, naturalW/75));
        ctx.font = `700 ${fontSize}px Arial, sans-serif`;
        const pad=4;
        const tw=Math.min(ctx.measureText(label).width+pad*2, naturalW-x);
        const th=fontSize+pad*2;
        const ly=Math.max(0,y-th);
        ctx.fillStyle='rgba(15,23,42,.88)';
        ctx.fillRect(x,ly,tw,th);
        ctx.fillStyle='#fff';
        ctx.fillText(label,x+pad,ly+fontSize+1);
      }
      ctx.restore();
    };

    const words=(ocr.consolidatedWords||ocr.words||[]).filter(w=>w?.bbox).slice(0,260);
    words.forEach(w=>drawBox(w.bbox,'rgba(99,102,241,.72)','rgba(99,102,241,.06)','OCR'));

    (ocr.regions||[]).forEach(r=>{
      if(r && r.x0!=null && r.x1!=null && r.y0!=null && r.y1!=null){
        drawBox({x0:Number(r.x0)*W,y0:Number(r.y0)*H,x1:Number(r.x1)*W,y1:Number(r.y1)*H},'rgba(14,165,233,.75)','rgba(14,165,233,.05)','Región');
      }
    });

    (ocr.consensusLines||[]).forEach(l=>drawBox(l.bbox,'rgba(16,185,129,.80)','rgba(16,185,129,.05)','Línea'));
    (ocr.criticalEvidence||[]).forEach(e=>drawBox(e.bbox,'rgba(220,38,38,.95)','rgba(220,38,38,.12)','Crítica'));
  };

  // Esperar a que la imagen tenga sus dimensiones reales. Esto evita que
  // el canvas se pinte antes de que el <img> haya cargado.
  if (img.complete && img.naturalWidth) paint();
  else img.addEventListener('load', paint, {once:true});
}

function renderDeterministic(card, validation, categoryKey) {
  const box = card.querySelector('[data-role="deterministic"]');

  if (validation.passed) {
    box.innerHTML = `
      <div class="p-3 rounded-xl bg-green-50 border border-green-100">
        <div class="font-semibold text-sm text-green-700">✓ Reglas exactas: sin coincidencias</div>
        <div class="text-xs text-green-600 mt-1">
          No se encontraron frases prohibidas exactas, contextuales ni evidencia crítica en ${escapeHtml(categoryRules[categoryKey].label)}.
        </div>
      </div>
    `;
  } else {
    box.innerHTML = `
      <div class="p-3 rounded-xl bg-red-50 border border-red-100">
        <div class="font-semibold text-sm text-red-700">✕ Reglas exactas: infracción</div>
        <div class="text-xs text-red-600 mt-1">
          ${[...validation.matchedRules.map(r=>`Exacta: ${escapeHtml(r)}`), ...validation.contextualMatches.map(r=>`Contextual: ${escapeHtml(r)}`), ...([...new Map((validation.criticalMatches||[]).map(r=>[norm(r.evidence),r])).values()].map(r=>`Evidencia crítica: ${escapeHtml(r.evidence)}`))].join(", ")}
        </div>
      </div>
    `;
  }
}

function renderSemantic(card, result, mode) {
  const box = card.querySelector('[data-role="semantic"]');

  const styles = {
    APPROVED: "bg-green-50 border-green-100 text-green-700",
    REJECTED: "bg-red-50 border-red-100 text-red-700",
    REVIEW: "bg-amber-50 border-amber-100 text-amber-700"
  };

  const css = styles[result.decision] || styles.REVIEW;

  const uniqueViolations = [];
  const seenViolations = new Set();
  for (const v of (result.violations || [])) {
    const key = norm(`${v.rule||''}|${v.evidence||''}`);
    if (!seenViolations.has(key)) { seenViolations.add(key); uniqueViolations.push(v); }
  }
  const violations = uniqueViolations.map(v => `
    <li>
      <b>${escapeHtml(v.rule || "Regla")}</b>
      ${v.evidence ? ` — evidencia: “${escapeHtml(v.evidence)}”` : ""}
    </li>
  `).join("");

  box.innerHTML = `
    <div class="p-3 rounded-xl border ${css}">
      <div class="flex items-center justify-between gap-2">
        <div class="font-bold text-sm">
          ${escapeHtml(result.decision)}
        </div>
        <span class="text-[11px] font-semibold px-2 py-1 rounded-full bg-white/70">
          Riesgo: ${escapeHtml(result.risk_level || "UNKNOWN")}
        </span>
      </div>

      <div class="text-xs mt-2">
        ${escapeHtml(result.explanation || "")}
      </div>

      ${
        violations
          ? `<ul class="text-xs list-disc ml-4 mt-2 space-y-1">${violations}</ul>`
          : ""
      }

      <div class="text-[10px] opacity-60 mt-2">
        Motor: ${mode === "cohere" ? "Cohere" : "Simulación semántica"}
      </div>
    </div>
  `;
}

/* ============================================================
   14. PROCESAMIENTO DEL LOTE
   ============================================================ */

analyzeBatchBtn.addEventListener("click", analyzeBatch);

async function analyzeBatch() {
  if (!state.files.length) return;

  const batchCategory = state.currentCategory;
  const mode = "simulation";

  /*
    La categoría queda congelada al iniciar el lote.
    Así cambiar el selector durante el procesamiento no altera
    accidentalmente los banners que ya están siendo evaluados.
  */
  state.files.forEach(item => {
    item.category = batchCategory;
  });

  analyzeBatchBtn.disabled = true;
  categorySelect.disabled = true;
  aiMode.disabled = true;
  batchProgress.classList.remove("hidden");

  const worker = await getWorker();

  resetAnalysisStages();
  if (analysisElapsed) analysisElapsed.textContent = "0.0 s";
  const batchStart = performance.now();
  let processed = 0;
  const total = state.files.length;

  for (const item of state.files) {
    const card = document.getElementById(item.id);
    const status = card.querySelector('[data-role="status"]');
    const ocrArea = card.querySelector('[data-role="ocr"]');

    status.textContent = "OCR...";
    status.className =
      "shrink-0 text-xs px-2.5 py-1 rounded-full bg-blue-100 text-blue-700";

    setProgress(processed, total, `Analizando imagen… ${item.file.name}`);
    resetAnalysisStages();
    const itemStart = performance.now();
    const stageTiming = {};
    const stageLabels = {prepare:"Preparando imagen",main:"OCR principal",regions:"Analizando regiones",consolidate:"Consolidando resultados",reconstruct:"Reconstruyendo texto",validate:"Validando contenido"};
    try {
      const ocr = await recognizeImage(worker, item.imageUrl, item.category, (stage, stageState) => {
        const now = performance.now();
        if (stageState === "active") stageTiming[stage] = {start: now, end: null, durationMs: 0};
        if (stageState === "done") {
          if (!stageTiming[stage]) stageTiming[stage] = {start: now, end: now, durationMs: 0};
          stageTiming[stage].end = now;
          stageTiming[stage].durationMs = Math.max(0, now - stageTiming[stage].start);
        }
        setAnalysisStage(stage, stageState);
        const stageTimeEl = analysisStages?.querySelector(`[data-stage-time="${stage}"]`);
        if (stageTimeEl && stageTiming[stage]) stageTimeEl.textContent = stageTiming[stage].end ? `· ${formatElapsed(stageTiming[stage].durationMs)}` : `· en curso`;
        if (analysisElapsed) analysisElapsed.textContent = formatElapsed(now - itemStart);
      });
      setAnalysisStage("validate", "active");
      const contextual = applyContextualDictionary(ocr, item.category);
      ocr.contextual = contextual;
      ocrArea.value = ocr.text;
      const reconstructedEl = card.querySelector('[data-ocr-reconstructed]');
      if (reconstructedEl) reconstructedEl.textContent = ocr.text || 'No se pudo reconstruir texto.';
      const criticalListEl = card.querySelector('[data-ocr-critical-list]');
      if (criticalListEl) {
        const criticals = ocr.criticalEvidence || [];
        criticalListEl.innerHTML = criticals.length
          ? criticals.map(e => `<div class="ocr-critical-item"><b>${escapeHtml(e.evidence || e.tokens?.join(' ') || 'Evidencia crítica')}</b><div class="mt-1 text-[10px] text-red-700">Fuentes: ${Number(e.sourceCount)||1} · Confianza máxima: ${Math.round(Number(e.confidence)||0)}%</div></div>`).join('')
          : '<div class="text-[11px] text-slate-500">Sin evidencia crítica detectada.</div>';
      }

      const ocrPanel = card.querySelector('[data-role="ocr-enhanced"]');
      if (ocrPanel) {
        const setText = (selector, value) => { const el = ocrPanel.querySelector(selector); if (el) el.textContent = String(value); };
        setText('[data-ocr-detected]', ocr.detectedWordCount);
        setText('[data-ocr-candidates]', ocr.candidateWordCount);
        setText('[data-ocr-consolidated]', ocr.consolidatedWordCount);
        setText('[data-ocr-final-lines]', ocr.finalLineCount);
        setText('[data-ocr-confidence]', `${ocr.averageConfidence}%`);
        setText('[data-ocr-high]', ocr.confidenceBuckets.high);
        setText('[data-ocr-medium]', ocr.confidenceBuckets.medium);
        setText('[data-ocr-low]', ocr.confidenceBuckets.low);
        setText('[data-ocr-duplicates]', ocr.discardedAlternatives || 0);
        setText('[data-ocr-critical-unique]', (ocr.criticalEvidence || []).length);
        setText('[data-ocr-agreement]', `${ocr.agreementOverall}%`);
        const tc = ocrPanel.querySelector('[data-ocr-text-consensus]');
        if (tc) tc.textContent = `${ocr.textConsensus}%`;
        const note = ocrPanel.querySelector('[data-ocr-consensus-note]');
        if (note) note.textContent = `OCR híbrido + consolidación espacial/textual · ${ocr.finalLineCount || ocr.consensusLines.length} líneas finales · ${ocr.discardedAlternatives || 0} alternativas descartadas.`;
        const corr = ocrPanel.querySelector('[data-ocr-corrections]');
        if (corr) corr.textContent = String(contextual.corrections.length);
        const cm = ocrPanel.querySelector('[data-ocr-context-matches]');
        if (cm) cm.textContent = String(contextual.contextualMatches.length);
        const cl = ocrPanel.querySelector('[data-ocr-context-list]');
        if (cl) cl.innerHTML = `<div class="mb-1 text-slate-500">El texto mostrado arriba es el OCR reconstruido; las correcciones contextuales se mantienen separadas para auditoría.</div>` + contextual.corrections.slice(0,6).map(c => `<span class="inline-block mr-2">${escapeHtml(c.raw)} → <b>${escapeHtml(c.corrected)}</b> (${Math.min(100, Number(c.score)||0)}%)</span>`).join('');

        const reviewAlert = ocrPanel.querySelector('[data-ocr-review-alert]');
        const reviewList = ocrPanel.querySelector('[data-ocr-review-list]');
        const fragments = ocr.reviewFragments || [];
        if (reviewAlert) {
          reviewAlert.classList.toggle('hidden', fragments.length === 0);
          reviewAlert.innerHTML = fragments.length === 1
            ? `⚠️ <b>1 fragmento necesita revisión</b>`
            : `⚠️ <b>${fragments.length} fragmentos necesitan revisión</b>`;
        }
        if (reviewList) {
          reviewList.classList.toggle('hidden', fragments.length === 0);
          reviewList.innerHTML = fragments.map(f => `<div class="ocr-review-item"><span class="font-semibold">Fragmento:</span> ${escapeHtml(f.text)} <span class="text-slate-400">(${f.confidence}% confianza)</span></div>`).join('');
        }

        const uiCoverage = card.querySelector('[data-ocr-ui-coverage]');
        const uiAgreement = card.querySelector('[data-ocr-ui-agreement]');
        const structuralCoverage = Number.isFinite(Number(ocr.metrics?.structuralCoverage)) ? Number(ocr.metrics.structuralCoverage) : (Number(ocr.structuralBandCount) > 0 ? (Number(ocr.finalLineCount || 0) / Number(ocr.structuralBandCount) * 100) : 0);
        const lineAgreement = Number.isFinite(Number(ocr.metrics?.lineAgreement)) ? Number(ocr.metrics.lineAgreement) : Number(ocr.textConsensus || ocr.agreementOverall || 0);
        if (uiCoverage) uiCoverage.textContent = `${Math.round(structuralCoverage)}%`;
        if (uiAgreement) uiAgreement.textContent = `${Math.round(lineAgreement)}%`;

        ocrPanel.querySelector('[data-ocr-passes]').innerHTML = ocr.passStats.map(p => `<span class="ocr-pass">${escapeHtml(p.label)}: ${p.accepted}/${p.raw} · ${p.confidence}%${p.error ? ' · error' : ''}</span>`).join('');
      }

      renderOCROverlay(card, item, ocr);

      const stageTimesEl = card.querySelector('[data-role="stage-times"]');
      if (stageTimesEl) {
        stageTimesEl.innerHTML = Object.keys(stageLabels).map(key => {
          const t = stageTiming[key]?.durationMs;
          return `<div class="flex justify-between gap-3"><span>${escapeHtml(stageLabels[key])}</span><b>${t == null ? '—' : escapeHtml(formatElapsed(t))}</b></div>`;
        }).join('');
      }

      const deterministic = deterministicValidation(
        ocr.text,
        item.category,
        contextual.contextualText,
        ocr.criticalEvidence || []
      );

      renderDeterministic(card, deterministic, item.category);

      const payload = buildCoherePayload(
        item,
        ocr.text,
        deterministic
      );

      let semanticResult;

      if (mode === "cohere") {
        semanticResult = await callCohere(payload);
      } else {
        semanticResult = simulateCohere(payload);
      }

      renderSemantic(card, semanticResult, mode);

      const finalSummary = card.querySelector('[data-role="final-summary"]');
      if (finalSummary) {
        const decision = semanticResult.decision || (deterministic.passed ? 'APPROVED' : 'REJECTED');
        const risk = semanticResult.risk_level || (deterministic.passed ? 'LOW' : 'HIGH');
        const reasons = [
          ...(deterministic.matchedRules || []).map(r => `Exacta: ${r}`),
          ...(deterministic.contextualMatches || []).map(r => `Contextual: ${r}`),
          ...([...new Map((deterministic.criticalMatches || []).map(r => [norm(r.evidence), r])).values()].map(r => `Evidencia crítica: ${r.evidence}`))
        ];
        finalSummary.classList.remove('approved','review');
        if(decision==='APPROVED') finalSummary.classList.add('approved');
        else if(decision==='REVIEW') finalSummary.classList.add('review');
        const d=finalSummary.querySelector('[data-final-decision]');
        const r=finalSummary.querySelector('[data-final-risk]');
        const why=finalSummary.querySelector('[data-final-reasons]');
        if(d) d.textContent=decision;
        if(r){ r.textContent=`Riesgo: ${risk}`; r.className='text-[10px] font-bold px-2 py-1 rounded-full '+(risk==='HIGH'?'bg-red-100 text-red-700':risk==='MEDIUM'?'bg-amber-100 text-amber-700':'bg-green-100 text-green-700'); }
        if(why) why.textContent=reasons.length ? reasons.join(' · ') : (semanticResult.explanation || 'Sin hallazgos regulatorios.');
      }

      setAnalysisStage("validate", "done");
      const durationMs = Math.round(performance.now() - itemStart);
      const durationEl = card.querySelector('[data-role="duration"]');
      const uiDuration = card.querySelector('[data-ocr-ui-duration]');
      if (uiDuration) uiDuration.textContent = formatElapsed(durationMs);
      if (durationEl) durationEl.textContent = `Tiempo de análisis: ${formatElapsed(durationMs)}`;
      if (analysisElapsed) analysisElapsed.textContent = formatElapsed(performance.now() - itemStart);

      status.textContent = semanticResult.decision;

      if (semanticResult.decision === "APPROVED") {
        status.className =
          "shrink-0 text-xs px-2.5 py-1 rounded-full bg-green-100 text-green-700 font-bold";
      } else if (semanticResult.decision === "REJECTED") {
        status.className =
          "shrink-0 text-xs px-2.5 py-1 rounded-full bg-red-100 text-red-700 font-bold";
      } else {
        status.className =
          "shrink-0 text-xs px-2.5 py-1 rounded-full bg-amber-100 text-amber-700 font-bold";
      }

      state.results.push({
        ...item,
        category: item.category,
        ocr,
        deterministic,
        payload,
        semantic: semanticResult,
        analysisDurationMs: Math.round(performance.now() - itemStart)
      });

    } catch (error) {
      console.error(error);

      status.textContent = "ERROR";
      status.className =
        "shrink-0 text-xs px-2.5 py-1 rounded-full bg-red-100 text-red-700 font-bold";

      if (analysisElapsed) analysisElapsed.textContent = formatElapsed(performance.now() - itemStart);
      const durationEl = card.querySelector('[data-role="duration"]');
      if (durationEl) durationEl.textContent = `Tiempo de análisis: ${formatElapsed(performance.now() - itemStart)} · error`;
      card.querySelector('[data-role="semantic"]').innerHTML = `
        <div class="p-3 rounded-xl bg-red-50 border border-red-100 text-red-700 text-xs">
          No fue posible completar el análisis: ${escapeHtml(error.message)}
        </div>
      `;
    }

    processed++;
    setProgress(processed, total, `${processed}/${total} procesados`);
  }

  analyzeBatchBtn.disabled = false;
  categorySelect.disabled = false;
  aiMode.disabled = false;

  const batchElapsed = performance.now() - batchStart;
  summary.textContent = `${total} banner(s) procesado(s) · tiempo total: ${formatElapsed(batchElapsed)}`;
  setProgress(total, total, `Análisis completado · ${formatElapsed(batchElapsed)}`);
}

/* ============================================================
   15. LIMPIAR
   ============================================================ */

clearBtn.addEventListener("click", async () => {
  state.files.forEach(item => {
    if (item.imageUrl) URL.revokeObjectURL(item.imageUrl);
  });

  state.files = [];
  state.results = [];

  resultsContainer.innerHTML = "";
  analyzeBatchBtn.disabled = true;
  batchProgress.classList.add("hidden");
  summary.textContent = "";

  if (state.worker) {
    await state.worker.terminate();
    state.worker = null;
  }

  engineStatus.textContent = "Motor listo";
  engineStatus.className =
    "text-xs px-3 py-1.5 rounded-full bg-blue-100 text-blue-700 font-medium";
});

/* ============================================================
   16. EXPORTAR DATOS PARA DEBUG / BACKEND
   ============================================================ */

window.BannerValidator = {
  getResultsJSON() {
    return JSON.parse(JSON.stringify(state.results));
  },

  getLastPayload() {
    const last = state.results[state.results.length - 1];
    return last ? JSON.parse(JSON.stringify(last.payload)) : null;
  },

  validateText(text, category = state.currentCategory) {
    const deterministic = deterministicValidation(text, category);
    const fakeItem = {
      file: { name: "manual-input", type: "text/plain" },
      category
    };

      onStage("validate", "done");

return {
      payload: buildCoherePayload(fakeItem, text, deterministic),
      simulation: simulateCohere(
        buildCoherePayload(fakeItem, text, deterministic)
      )
    };
  }
};
</script>
